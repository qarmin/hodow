#version 450
#extension GL_EXT_shader_atomic_float : enable
#extension GL_EXT_shader_atomic_float2 : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_NV_shader_atomic_fp16_vector : enable

precision highp imageCubeArray; 
layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout (r32f, binding=0) coherent uniform imageCubeArray u_resultImage;
layout (r32f, binding=1) writeonly uniform imageCubeArray u_intermValuesImage;

#define TOVEC4(x) vec4(x)

void main (void)
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    int gz = int(gl_GlobalInvocationID.z);
    imageStore(u_intermValuesImage, ivec3(gx,gy,gz), TOVEC4(imageAtomicMax(u_resultImage, ivec3(gx % 64,gy,gz), float((1 - 2*(gx % 2)) * (gx*gx + gy*gy + gz*gz)))));
}
