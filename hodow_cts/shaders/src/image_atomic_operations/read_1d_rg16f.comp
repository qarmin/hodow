#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
precision highp image1D;

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout (rg16f, binding=0) coherent uniform image1D u_resultImage;

layout(std430, binding = 1) buffer outputBuffer
{
    f16vec2 data[];
} outBuffer;

void main(void)
{
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    int gz = int(gl_GlobalInvocationID.z);
    uint index = gx + (gy * gl_NumWorkGroups.x) + (gz *gl_NumWorkGroups.x * gl_NumWorkGroups.y);
    outBuffer.data[index] = f16vec2(imageLoad(u_resultImage, gx).xy);
}
