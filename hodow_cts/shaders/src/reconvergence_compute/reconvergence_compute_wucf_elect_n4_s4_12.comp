                    for (int loopIdx0 = 0;
                             loopIdx0 < inputA.a[4];
                             loopIdx0++) {
                    }
                    if (testBit(uvec4(0x66771ea4, 0xdcbcd9da, 0xa556d272, 0xe8367673), gl_SubgroupInvocationID)) {
                    }
                } else {
                    for (int loopIdx0 = 0;
