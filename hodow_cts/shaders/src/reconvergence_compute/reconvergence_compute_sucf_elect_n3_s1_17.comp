                        }
                        case 1:
                        {
                            break;
                        }
                        case 3:
                        {
                            break;
                        }
                    }
                    break;
                }
            }
            break;
        }
        case 1:
        {
            if (testBit(uvec4(0x9038cf5, 0xd8aac545, 0x56fa1a3f, 0xb21b6b7e), gl_SubgroupInvocationID)) {
