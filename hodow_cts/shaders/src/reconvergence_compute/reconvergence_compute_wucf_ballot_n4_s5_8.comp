                        outputB.b[(outLoc++)*invocationStride + gl_LocalInvocationIndex].x = 0x10013;
                        outputC.loc[gl_LocalInvocationIndex]++,outputB.b[(outLoc++)*invocationStride + gl_LocalInvocationIndex] = subgroupBallot(true);
