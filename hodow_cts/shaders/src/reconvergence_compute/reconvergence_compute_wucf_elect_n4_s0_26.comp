                    outputB.b[(outLoc++)*invocationStride + gl_LocalInvocationIndex].x = 0x10031;
                    outputC.loc[gl_LocalInvocationIndex]++,outputB.b[(outLoc++)*invocationStride + gl_LocalInvocationIndex].x = elect();
