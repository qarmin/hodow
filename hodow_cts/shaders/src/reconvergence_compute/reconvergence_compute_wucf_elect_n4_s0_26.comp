            outputB.b[(outLoc++)*invocationStride + gl_LocalInvocationIndex].x = 0x10020;
            outputC.loc[gl_LocalInvocationIndex]++,outputB.b[(outLoc++)*invocationStride + gl_LocalInvocationIndex].x = elect();
            for (int loopIdx0 = 0;
                     loopIdx0 < inputA.a[2];
