                }
                outputC.loc[gl_LocalInvocationIndex]++;
                outputB.b[(outLoc++)*invocationStride + gl_LocalInvocationIndex].x = 0x10034;
                if (gl_LocalInvocationIndex >= inputA.a[cmpIndex1]) {
