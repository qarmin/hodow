#version 450
layout(set = 0, binding = 0) buffer Block0
{
    vec4 color;
} inputDataDyn[2];
layout(set = 1, binding = 0) writeonly buffer Output
{
    vec4 color;
} outData;

void main()
{
    outData.color = vec4(0, 0, 0, 1);
    outData.color.rgb += inputDataDyn[0].color.rgb;
    outData.color.rgb += inputDataDyn[1].color.rgb;
}
