#version 440
${extensions}
layout (local_size_x = ${wx}, local_size_y = ${wy}, local_size_z = ${wz}) in;
layout (binding = 0, ${qualifier}) writeonly uniform highp ${image_type} u_image;
void main (void)
{
    if( gl_GlobalInvocationID.x < ${w} )
    if( gl_GlobalInvocationID.y < ${h} )
    if( gl_GlobalInvocationID.z < ${d} )
    {
        imageStore(u_image, ${coord}, ${data_type}(${values}));
    }
}
