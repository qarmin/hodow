#version 450
#extension GL_EXT_mesh_shader : enable
layout (local_size_x=1, local_size_y=1, local_size_z=1) in;
layout(set = 0, binding = 0) buffer Output {
    uint values[4];
} buffer_out;

void main ()
{
    buffer_out.values[0] = 0u;
    buffer_out.values[1] = 1u;
    EmitMeshTasksEXT(1u, 1u, 1u);
}
