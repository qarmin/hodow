#version 450
#extension GL_NV_mesh_shader : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout (local_size_x=1) in;
layout (max_primitives=2, max_vertices=4) out;
layout (triangles) out;

layout (location=0) out perprimitiveNV flat float16_t prim_f16d1_flat_0[];
layout (location=1) out f16vec3 vert_f16d3_inter_1[];
layout (location=2) out float16_t vert_f16d1_inter_0[];
layout (location=3) out f32vec3 vert_f32d3_inter_0[];
layout (location=4) out float32_t vert_f32d1_inter_0[];
layout (location=5) out f16vec4 vert_f16d4_inter_0[];
layout (location=6) out perprimitiveNV flat i16vec2 prim_i16d2_flat_0[];
layout (location=7) out f32vec2 vert_f32d2_inter_1[];
layout (location=8) out perprimitiveNV flat i64vec3 prim_i64d3_flat_0[];
layout (location=10) out perprimitiveNV flat i16vec4 prim_i16d4_flat_1[];
layout (location=11) out perprimitiveNV flat i64vec3 prim_i64d3_flat_1[];
layout (location=13) out flat i16vec2 vert_i16d2_flat_0[];
layout (location=14) out perprimitiveNV flat float64_t prim_f64d1_flat_1[];
layout (location=15) out perprimitiveNV flat f32vec4 prim_f32d4_flat_0[];
out gl_MeshPerVertexNV {
   vec4  gl_Position;
} gl_MeshVerticesNV[];
out perprimitiveNV gl_MeshPerPrimitiveNV {
  int gl_PrimitiveID;
} gl_MeshPrimitivesNV[];

in taskNV TaskData {
    float16_t prim_f16d1_flat_0[2];
    f16vec3 vert_f16d3_inter_1[4];
    float16_t vert_f16d1_inter_0[4];
    f32vec3 vert_f32d3_inter_0[4];
    float32_t vert_f32d1_inter_0[4];
    f16vec4 vert_f16d4_inter_0[4];
    i16vec2 prim_i16d2_flat_0[2];
    f32vec2 vert_f32d2_inter_1[4];
    i64vec3 prim_i64d3_flat_0[2];
    i16vec4 prim_i16d4_flat_1[2];
    i64vec3 prim_i64d3_flat_1[2];
    i16vec2 vert_i16d2_flat_0[4];
    float64_t prim_f64d1_flat_1[2];
    f32vec4 prim_f32d4_flat_0[2];
} td;
vec4 positions[4] = vec4[](
    vec4(-1.0, -1.0, 0.0, 1.0),
    vec4( 1.0, -1.0, 0.0, 1.0),
    vec4(-1.0,  1.0, 0.0, 1.0),
    vec4( 1.0,  1.0, 0.0, 1.0)
);

int indices[6] = int[](
    0, 1, 2, 2, 3, 1
);

void main ()
{
    gl_PrimitiveCountNV = 2;

    gl_MeshVerticesNV[0].gl_Position = positions[0];
    gl_MeshVerticesNV[1].gl_Position = positions[1];
    gl_MeshVerticesNV[2].gl_Position = positions[2];
    gl_MeshVerticesNV[3].gl_Position = positions[3];

    gl_PrimitiveIndicesNV[0] = indices[0];
    gl_PrimitiveIndicesNV[1] = indices[1];
    gl_PrimitiveIndicesNV[2] = indices[2];
    gl_PrimitiveIndicesNV[3] = indices[3];
    gl_PrimitiveIndicesNV[4] = indices[4];
    gl_PrimitiveIndicesNV[5] = indices[5];

    gl_MeshPrimitivesNV[0].gl_PrimitiveID = 0;
    gl_MeshPrimitivesNV[1].gl_PrimitiveID = 1;

    prim_f16d1_flat_0[0] = float16_t(td.prim_f16d1_flat_0[0]);
    prim_f16d1_flat_0[1] = float16_t(td.prim_f16d1_flat_0[1]);
    vert_f16d3_inter_1[0] = f16vec3(td.vert_f16d3_inter_1[0]);
    vert_f16d3_inter_1[1] = f16vec3(td.vert_f16d3_inter_1[1]);
    vert_f16d3_inter_1[2] = f16vec3(td.vert_f16d3_inter_1[2]);
    vert_f16d3_inter_1[3] = f16vec3(td.vert_f16d3_inter_1[3]);
    vert_f16d1_inter_0[0] = float16_t(td.vert_f16d1_inter_0[0]);
    vert_f16d1_inter_0[1] = float16_t(td.vert_f16d1_inter_0[1]);
    vert_f16d1_inter_0[2] = float16_t(td.vert_f16d1_inter_0[2]);
    vert_f16d1_inter_0[3] = float16_t(td.vert_f16d1_inter_0[3]);
    vert_f32d3_inter_0[0] = f32vec3(td.vert_f32d3_inter_0[0]);
    vert_f32d3_inter_0[1] = f32vec3(td.vert_f32d3_inter_0[1]);
    vert_f32d3_inter_0[2] = f32vec3(td.vert_f32d3_inter_0[2]);
    vert_f32d3_inter_0[3] = f32vec3(td.vert_f32d3_inter_0[3]);
    vert_f32d1_inter_0[0] = float32_t(td.vert_f32d1_inter_0[0]);
    vert_f32d1_inter_0[1] = float32_t(td.vert_f32d1_inter_0[1]);
    vert_f32d1_inter_0[2] = float32_t(td.vert_f32d1_inter_0[2]);
    vert_f32d1_inter_0[3] = float32_t(td.vert_f32d1_inter_0[3]);
    vert_f16d4_inter_0[0] = f16vec4(td.vert_f16d4_inter_0[0]);
    vert_f16d4_inter_0[1] = f16vec4(td.vert_f16d4_inter_0[1]);
    vert_f16d4_inter_0[2] = f16vec4(td.vert_f16d4_inter_0[2]);
    vert_f16d4_inter_0[3] = f16vec4(td.vert_f16d4_inter_0[3]);
    prim_i16d2_flat_0[0] = i16vec2(td.prim_i16d2_flat_0[0]);
    prim_i16d2_flat_0[1] = i16vec2(td.prim_i16d2_flat_0[1]);
    vert_f32d2_inter_1[0] = f32vec2(td.vert_f32d2_inter_1[0]);
    vert_f32d2_inter_1[1] = f32vec2(td.vert_f32d2_inter_1[1]);
    vert_f32d2_inter_1[2] = f32vec2(td.vert_f32d2_inter_1[2]);
    vert_f32d2_inter_1[3] = f32vec2(td.vert_f32d2_inter_1[3]);
    prim_i64d3_flat_0[0] = i64vec3(td.prim_i64d3_flat_0[0]);
    prim_i64d3_flat_0[1] = i64vec3(td.prim_i64d3_flat_0[1]);
    prim_i16d4_flat_1[0] = i16vec4(td.prim_i16d4_flat_1[0]);
    prim_i16d4_flat_1[1] = i16vec4(td.prim_i16d4_flat_1[1]);
    prim_i64d3_flat_1[0] = i64vec3(td.prim_i64d3_flat_1[0]);
    prim_i64d3_flat_1[1] = i64vec3(td.prim_i64d3_flat_1[1]);
    vert_i16d2_flat_0[0] = i16vec2(td.vert_i16d2_flat_0[0]);
    vert_i16d2_flat_0[1] = i16vec2(td.vert_i16d2_flat_0[1]);
    vert_i16d2_flat_0[2] = i16vec2(td.vert_i16d2_flat_0[2]);
    vert_i16d2_flat_0[3] = i16vec2(td.vert_i16d2_flat_0[3]);
    prim_f64d1_flat_1[0] = float64_t(td.prim_f64d1_flat_1[0]);
    prim_f64d1_flat_1[1] = float64_t(td.prim_f64d1_flat_1[1]);
    prim_f32d4_flat_0[0] = f32vec4(td.prim_f32d4_flat_0[0]);
    prim_f32d4_flat_0[1] = f32vec4(td.prim_f32d4_flat_0[1]);

}
