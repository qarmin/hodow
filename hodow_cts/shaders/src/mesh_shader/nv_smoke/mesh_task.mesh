#version 450
#extension GL_NV_mesh_shader : enable

layout(local_size_x=32) in;
layout(triangles) out;
layout(max_vertices=256, max_primitives=256) out;

layout (set=0, binding=0) uniform CoordsBuffer {
    vec4 coords[4];
} cb;
layout (set=0, binding=1, std430) readonly buffer IndexBuffer {
    uint indices[6];
} ib;

layout (location=0) out perprimitiveNV vec4 triangleColor[];

in taskNV TaskData {
    uint triangleIndex;
} td;

void main ()
{
    if (gl_LocalInvocationIndex == 0u)
    {
        gl_PrimitiveCountNV = 1u;
        triangleColor[0] = vec4(0.0, 0.0, 1.0, 1.0);
    }

    if (gl_LocalInvocationIndex < 3u)
    {

        const uint triangleVertex = gl_LocalInvocationIndex;
        const uint coordsIndex    = ib.indices[td.triangleIndex * 3u + triangleVertex];

        gl_MeshVerticesNV[triangleVertex].gl_Position = cb.coords[coordsIndex];
        gl_PrimitiveIndicesNV[triangleVertex] = triangleVertex;
    }
}
