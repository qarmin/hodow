#version 450 core
#pragma use_vulkan_memory_model
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable
#extension GL_EXT_split_barrier : enable
#extension GL_EXT_bfloat16 : enable
#extension GL_EXT_float_e5m2 : enable
#extension GL_EXT_float_e4m3 : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_bfloat16 : enable
// strides overriden by spec constants
layout(constant_id = 2) const int AStride = 1;
layout(constant_id = 3) const int BStride = 1;
layout(constant_id = 4) const int CStride = 1;
layout(constant_id = 5) const int OStride = 1;
layout(constant_id = 6) const int M = 1;
layout(constant_id = 7) const int N = 1;
layout(constant_id = 8) const int K = 1;
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;
const int workgroupsX = 4;
const uvec2 subgroupsPerWG = uvec2(1, 2);
layout(set=0, binding=0) coherent buffer InputA { bfloat16_t x[]; } inputA;
layout(set=0, binding=1) coherent buffer InputB { bfloat16_t x[]; } inputB;
layout(set=0, binding=2) coherent buffer InputC { float32_t x[]; } inputC;
layout(set=0, binding=3) coherent buffer Output { float32_t x[]; } outputO;
shared bfloat16_t sharedA[M * K * subgroupsPerWG.x * subgroupsPerWG.y];
shared bfloat16_t sharedB[K * N * subgroupsPerWG.x * subgroupsPerWG.y];
shared float32_t sharedC[M * N * subgroupsPerWG.x * subgroupsPerWG.y];
shared float32_t sharedO[M * N * subgroupsPerWG.x * subgroupsPerWG.y];
#define ARows M
#define ACols K
#define ORows M
#define OCols N
coopmat<bfloat16_t, gl_ScopeSubgroup, ARows, ACols, gl_MatrixUseA> matA;
coopmat<bfloat16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB> matB;
coopmat<float32_t, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> matC;
coopmat<float32_t, gl_ScopeSubgroup, ORows, OCols, gl_MatrixUseAccumulator> matO;
void main()
{
   uvec2 subgroupXY = uvec2(gl_SubgroupID % subgroupsPerWG.x, gl_SubgroupID / subgroupsPerWG.x);
   uvec2 matrixID = uvec2(gl_WorkGroupID.xy) * subgroupsPerWG + subgroupXY;
   if (gl_SubgroupID >= subgroupsPerWG.x * subgroupsPerWG.y)
       return;
   uint element0 = (M * 4 * K * matrixID.y + M * matrixID.x);
   uint element1 = (K * 4 * N * matrixID.y + K * matrixID.x);
   uint element2 = (M * 4 * N * matrixID.y + M * matrixID.x);
   uint element3 = (M * 4 * N * matrixID.y + M * matrixID.x);
   uint elementS0, elementS1, elementS2, elementS3;
       elementS0 = (M * 4 / workgroupsX * K * subgroupXY.y + M * subgroupXY.x);
       elementS1 = (K * 4 / workgroupsX * N * subgroupXY.y + K * subgroupXY.x);
       elementS2 = (M * 4 / workgroupsX * N * subgroupXY.y + M * subgroupXY.x);
       elementS3 = (M * 4 / workgroupsX * N * subgroupXY.y + M * subgroupXY.x);
   for (uint step = 0u; step < 2u; ++step) {
       const float stepBiasA = (step == 0u) ? 0.0f : 1.0f;
   if (subgroupElect()) {
       for (int i = 0; i < M; ++i) {
       for (int j = 0; j < K; ++j) {
           int localElementInput = (M * 4 * j + i);
           int localElementShared = (M * 4 / workgroupsX * j + i);
           sharedA[elementS0 + localElementShared] = bfloat16_t(float(inputA.x[element0 + localElementInput]) + stepBiasA);
       }
       }
       for (int i = 0; i < K; ++i) {
       for (int j = 0; j < N; ++j) {
           int localElementInput = (K * 4 * j + i);
           int localElementShared = (K * 4 / workgroupsX * j + i);
           sharedB[elementS1 + localElementShared] = inputB.x[element1 + localElementInput];
       }
       }
       for (int i = 0; i < M; ++i) {
       for (int j = 0; j < N; ++j) {
           int localElementInput = (M * 4 * j + i);
           int localElementShared = (M * 4 / workgroupsX * j + i);
           sharedC[elementS2 + localElementShared] = inputC.x[element2 + localElementInput];
       }
       }
   }
   controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
   coopMatLoad(matA, sharedA, elementS0, M * 4 / workgroupsX, gl_CooperativeMatrixLayoutColumnMajor);
   coopMatLoad(matB, sharedB, elementS1, K * 4 / workgroupsX, gl_CooperativeMatrixLayoutColumnMajor);
   coopMatLoad(matC, sharedC, elementS2, M * 4 / workgroupsX, gl_CooperativeMatrixLayoutColumnMajor);
   controlBarrierArrive();
   if (step == 0u) {
     matO = coopMatMulAdd(matA, matB, matC);
   }
   else {
     matO = coopMatMulAdd(matA, matB, matO);
   }
   controlBarrierWait();
}
   coopMatStore(matO, sharedO, elementS3, M * 4 / workgroupsX, gl_CooperativeMatrixLayoutColumnMajor);
   controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
   if (subgroupElect()) {
       for (int i = 0; i < M; ++i) {
       for (int j = 0; j < N; ++j) {
           int localElementInput = (M * 4 * j + i);
           int localElementShared = (M * 4 / workgroupsX * j + i);
           outputO.x[element3 + localElementInput] = sharedO[elementS3 + localElementShared];
       }
       }
   }
}
