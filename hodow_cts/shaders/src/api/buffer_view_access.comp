#version 440
#extension GL_EXT_texture_buffer : require
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 1${fmt_layout}) uniform highp ${extra_option}${in_format}${storage_type} texelBuffer;
layout(set = 0, binding = 0, std140) writeonly buffer OutBuf
{
    highp ${out_format}vec4 read_colors[4];
} b_out;
void main (void)
{
    highp int quadrant_id = int(gl_WorkGroupID.x);
    highp ${out_format}vec4 result_color;
    result_color = ${out_format}vec4(0);
    if (quadrant_id == 0)
        result_color += ${out_format}vec4(${op_name}(texelBuffer, 6));
    else if (quadrant_id == 1)
        result_color += ${out_format}vec4(${op_name}(texelBuffer, 51));
    else if (quadrant_id == 2)
        result_color += ${out_format}vec4(${op_name}(texelBuffer, 42));
    else
        result_color += ${out_format}vec4(${op_name}(texelBuffer, 25));
    b_out.read_colors[gl_WorkGroupID.x] = result_color;
}
