#version 310 es
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 1) uniform highp texture3D u_separateTexture0;
layout(set = 0, binding = 2) uniform highp sampler u_separateSampler0A;
layout(set = 0, binding = 3) uniform highp sampler u_separateSampler0B;
layout(set = 1, binding = 0) uniform highp texture3D u_separateTexture1;
layout(set = 1, binding = 1) uniform highp sampler u_separateSampler1A;
layout(set = 1, binding = 2) uniform highp sampler u_separateSampler1B;
layout(set = 0, binding = 0, std140) writeonly buffer OutBuf
{
    highp vec4 read_colors[4];
} b_out;
void main (void)
{
    highp int quadrant_id = int(gl_WorkGroupID.x);
    highp vec4 result_color;
    result_color = vec4(0.0);
    if (quadrant_id == 0)
        result_color += textureLod(sampler3D(u_separateTexture0, u_separateSampler0A), vec3(float(0.0234375), float(0.015625), float(0.382812)), 0.0);
    else if (quadrant_id == 1)
        result_color += textureLod(sampler3D(u_separateTexture0, u_separateSampler0B), vec3(float(0.726562), float(0.296875), float(1.51562)), 0.0);
    else if (quadrant_id == 2)
        result_color += textureLod(sampler3D(u_separateTexture0, u_separateSampler0A), vec3(float(-0.335938), float(1.64062), float(0.679688)), 0.0);
    else
        result_color += textureLod(sampler3D(u_separateTexture0, u_separateSampler0B), vec3(float(1.01562), float(0.351562), float(1.60156)), 0.0);
    if (quadrant_id == 0)
        result_color += textureLod(sampler3D(u_separateTexture1, u_separateSampler1A), vec3(float(0.0234375), float(0.015625), float(0.382812)), 0.0);
    else if (quadrant_id == 1)
        result_color += textureLod(sampler3D(u_separateTexture1, u_separateSampler1B), vec3(float(0.726562), float(0.296875), float(1.51562)), 0.0);
    else if (quadrant_id == 2)
        result_color += textureLod(sampler3D(u_separateTexture1, u_separateSampler1A), vec3(float(-0.335938), float(1.64062), float(0.679688)), 0.0);
    else
        result_color += textureLod(sampler3D(u_separateTexture1, u_separateSampler1B), vec3(float(1.01562), float(0.351562), float(1.60156)), 0.0);
    result_color /= vec4(2.0);
    b_out.read_colors[gl_WorkGroupID.x] = result_color;
}
