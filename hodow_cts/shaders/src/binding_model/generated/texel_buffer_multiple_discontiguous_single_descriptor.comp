#version 310 es
#extension GL_EXT_texture_buffer : require
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 1, rgba8) uniform highp readonly imageBuffer u_texelBuffer0;
layout(set = 2, binding = 0, rgba8) uniform highp readonly imageBuffer u_texelBuffer1;
layout(set = 0, binding = 0, std140) writeonly buffer OutBuf
{
    highp vec4 read_colors[4];
} b_out;
void main (void)
{
    highp int quadrant_id = int(gl_WorkGroupID.x);
    highp vec4 result_color;
    result_color = vec4(0.0);
    if (quadrant_id == 0)
        result_color += imageLoad(u_texelBuffer0, 6);
    else if (quadrant_id == 1)
        result_color += imageLoad(u_texelBuffer0, 51);
    else if (quadrant_id == 2)
        result_color += imageLoad(u_texelBuffer0, 42);
    else
        result_color += imageLoad(u_texelBuffer0, 25);
    if (quadrant_id == 0)
        result_color += imageLoad(u_texelBuffer1, 6);
    else if (quadrant_id == 1)
        result_color += imageLoad(u_texelBuffer1, 51);
    else if (quadrant_id == 2)
        result_color += imageLoad(u_texelBuffer1, 42);
    else
        result_color += imageLoad(u_texelBuffer1, 25);
    result_color /= vec4(2.0);
    b_out.read_colors[gl_WorkGroupID.x] = result_color;
}
