#version 310 es
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 1, std140) buffer BufferName0
{
    highp vec4 colorA;
    highp vec4 colorB;
} b_instances0[2];
layout(set = 2, binding = 0, std140) buffer BufferName1
{
    highp vec4 colorA;
    highp vec4 colorB;
} b_instances1[2];
layout(set = 0, binding = 0, std140) writeonly buffer OutBuf
{
    highp vec4 read_colors[4];
} b_out;
void main (void)
{
    highp int quadrant_id = int(gl_WorkGroupID.x);
    highp vec4 result_color;
    result_color = vec4(0.0);
    if (quadrant_id == 1 || quadrant_id == 2)
        result_color += b_instances0[0].colorA;
    else
        result_color += b_instances0[1].colorB;
    if (quadrant_id == 1 || quadrant_id == 2)
        result_color += b_instances1[0].colorA;
    else
        result_color += b_instances1[1].colorB;
    result_color /= vec4(2.0);
    b_out.read_colors[gl_WorkGroupID.x] = result_color;
}
