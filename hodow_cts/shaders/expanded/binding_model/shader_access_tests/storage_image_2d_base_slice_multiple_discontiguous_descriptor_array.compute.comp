#version 310 es
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 1, rgba8) readonly uniform highp image2D u_image0[2];
layout(set = 2, binding = 0, rgba8) readonly uniform highp image2D u_image1[2];
layout(set = 0, binding = 0, std140) writeonly buffer OutBuf
{
    highp vec4 read_colors[4];
} b_out;
void main (void)
{
    highp int quadrant_id = int(gl_WorkGroupID.x);
    highp vec4 result_color;
    result_color = vec4(0.0);
    if (quadrant_id == 0)
        result_color += imageLoad(u_image0[0], ivec2(6, 13));
    else if (quadrant_id == 1)
        result_color += imageLoad(u_image0[1], ivec2(51, 40));
    else if (quadrant_id == 2)
        result_color += imageLoad(u_image0[0], ivec2(42, 26));
    else
        result_color += imageLoad(u_image0[1], ivec2(25, 25));
    if (quadrant_id == 0)
        result_color += imageLoad(u_image1[0], ivec2(6, 13));
    else if (quadrant_id == 1)
        result_color += imageLoad(u_image1[1], ivec2(51, 40));
    else if (quadrant_id == 2)
        result_color += imageLoad(u_image1[0], ivec2(42, 26));
    else
        result_color += imageLoad(u_image1[1], ivec2(25, 25));
    result_color /= vec4(2.0);
    b_out.read_colors[gl_WorkGroupID.x] = result_color;
}
