#version 310 es
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 1) uniform highp texture2DArray u_separateTexture;
layout(set = 0, binding = 2) uniform highp sampler u_separateSampler;
layout(set = 0, binding = 0, std140) writeonly buffer OutBuf
{
    highp vec4 read_colors[4];
} b_out;
void main (void)
{
    highp int quadrant_id = int(gl_WorkGroupID.x);
    highp vec4 result_color;
    result_color = vec4(0.0);
    if (quadrant_id == 0)
        result_color += textureLod(sampler2DArray(u_separateTexture, u_separateSampler), vec3(float(0.0234375), float(0.015625), float(0)), 0.0);
    else if (quadrant_id == 1)
        result_color += textureLod(sampler2DArray(u_separateTexture, u_separateSampler), vec3(float(0.726562), float(0.296875), float(0)), 0.0);
    else if (quadrant_id == 2)
        result_color += textureLod(sampler2DArray(u_separateTexture, u_separateSampler), vec3(float(-0.335938), float(1.64062), float(1)), 0.0);
    else
        result_color += textureLod(sampler2DArray(u_separateTexture, u_separateSampler), vec3(float(1.01562), float(0.351562), float(0)), 0.0);
    b_out.read_colors[gl_WorkGroupID.x] = result_color;
}
