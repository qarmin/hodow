#version 450

layout (local_size_x = 1, local_size_y = 2, local_size_z = 1) in;

layout (location = 0, rgba8) uniform image2DMS img0;
layout (location = 1, rgba8) uniform image2DMSArray img1;
layout (location = 2, rgba8) uniform image2DRect img2;
layout (location = 3, rgba8) uniform imageCube img3;
layout (location = 4, rgba8) uniform imageCubeArray img4;
layout (location = 5, rgba8) uniform imageBuffer img5;
layout (location = 6, rgba8) uniform image2D img6;
layout (location = 7, rgba8) uniform image1D img7;
layout (location = 8) uniform writeonly image1D img8;
layout (location = 9, rg32f) uniform image1D img9;
layout (location = 10) uniform sampler2DRect img10;
layout (location = 11) uniform samplerCubeArray img11;
layout (location = 12) uniform samplerBuffer img12;
layout (location = 13) uniform sampler1D img13;
layout (location = 14) uniform sampler2D img14;

layout (binding = 0) uniform atomic_uint atCounter;

void main()
{
    ivec2 size = imageSize(img6);
    ivec3 point = ivec3(gl_GlobalInvocationID);
    imageStore(img0, point.xy, 0, vec4(0));
    imageStore(img1, point, 0, vec4(0));
    imageStore(img2, point.xy, vec4(0));
    imageStore(img3, point, vec4(0));
    imageStore(img4, point, vec4(0));
    imageStore(img5, point.x, vec4(0));
    imageStore(img6, point.xy, vec4(0));
    imageStore(img7, point.x, vec4(0));
    imageStore(img8, point.x, vec4(0));

    vec3 coord = vec3(0);
    ivec2 offset = ivec2(gl_GlobalInvocationID.xy);
    vec4 color;
    color = textureGather(img10, coord.xy);
    color = textureGather(img11, vec4(0));
    color = texelFetch(img12, point.x);
    color = textureGatherOffset(img14, coord.xy, offset);
    memoryBarrier();
}
