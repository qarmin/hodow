/// 5 ImageLoadStoreUniformLimitsTest
#[derive(Default)]
pub(super) struct ImageLoadStoreUniformLimitsTest {
    result_for_combined: bool,
    result_for_fragment_shader: bool,
    result_for_geometry_shader: bool,
    result_for_tesselation_control_shader: bool,
    result_for_tesselatioon_evaluation_shader: bool,
    result_for_vertex_shader: bool,
}

/// `doesProgramLink`
fn does_program_link(gl: &glw::Functions, fragment_shader_code: &str, geometry_shader_code: Option<&str>, tesselation_control_shader_code: Option<&str>, tesselation_evaluation_shader_code: Option<&str>, vertex_shader_code: &str) -> bool {
    let mut is_program_built = true;
    let program_id = build_program_5(
        gl,
        Some(vertex_shader_code),
        tesselation_control_shader_code,
        tesselation_evaluation_shader_code,
        geometry_shader_code,
        Some(fragment_shader_code),
        Some(&mut is_program_built),
    );
    if program_id != 0 {
        gl!(gl.delete_program(program_id));
    }
    is_program_built
}

impl ImageLoadStoreUniformLimitsTest {
    fn test_fragment_shader_stage(&mut self, gl: &glw::Functions) {
        let fragment_shader_code = @LITDECL(11115);
        let vertex_shader_code = @LITDECL(11139);
        self.result_for_fragment_shader = !does_program_link(gl, fragment_shader_code, None, None, None, vertex_shader_code);
        if !self.result_for_fragment_shader {
            log::info!("Program which exceeds limit of GL_MAX_FRAGMENT_IMAGE_UNIFORMS was linked successfully. Shader code:\n{fragment_shader_code}");
        }
    }

    fn test_geometry_shader_stage(&mut self, gl: &glw::Functions) {
        let fragment_shader_code = @LITDECL(11171);
        let geometry_shader_code = @LITDECL(11181);
        let vertex_shader_code = @LITDECL(11206);
        self.result_for_geometry_shader = !does_program_link(gl, fragment_shader_code, Some(geometry_shader_code), None, None, vertex_shader_code);
        if !self.result_for_geometry_shader {
            log::info!("Program which exceeds limit of GL_MAX_GEOMETRY_IMAGE_UNIFORMS was linked successfully. Shader code:\n{geometry_shader_code}");
        }
    }

