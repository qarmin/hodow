    fn test_vertex_shader_stage(&mut self, gl: &glw::Functions) {
        let fragment_shader_code = @LITDECL(11382);
        let vertex_shader_code = @LITDECL(11392);
        self.result_for_vertex_shader = !does_program_link(gl, fragment_shader_code, None, None, None, vertex_shader_code);
        if !self.result_for_vertex_shader {
            log::info!("Program which exceeds limit of GL_MAX_VERTEX_IMAGE_UNIFORMS was linked successfully. Shader code:\n{vertex_shader_code}");
        }
    }

    fn test_combined_shader_stages(&mut self, gl: &glw::Functions) -> Result<(), crate::tcu::TestError> {
        let fragment_shader_code: String = @LITDECL(11433).to_string();
        let mut geometry_shader_code: String = @LITDECL(11456).to_string();
        let mut tesselation_control_shader_code: String = @LITDECL(11489).to_string();
        let mut tesselation_evaluation_shader_code: String = @LITDECL(11520).to_string();
        let mut vertex_shader_code: String = @LITDECL(11551).to_string();

        let max_combined_image_uniforms = get_integer(gl, glw::GL_MAX_COMBINED_IMAGE_UNIFORMS);
        let max_fragment_image_uniforms = get_integer(gl, glw::GL_MAX_FRAGMENT_IMAGE_UNIFORMS);
        let max_geometry_image_uniforms = get_integer(gl, glw::GL_MAX_GEOMETRY_IMAGE_UNIFORMS);
        let max_tesselation_control_image_uniforms = get_integer(gl, glw::GL_MAX_TESS_CONTROL_IMAGE_UNIFORMS);
        let max_tesselation_evaluation_image_uniforms = get_integer(gl, glw::GL_MAX_TESS_EVALUATION_IMAGE_UNIFORMS);
        let max_vertex_image_uniforms = get_integer(gl, glw::GL_MAX_VERTEX_IMAGE_UNIFORMS);
        glu::expect_no_error(gl, "GetIntegerv")?;

        if max_vertex_image_uniforms != 0 {
            vertex_shader_code.insert_str(18, "#define IMAGES\n");
        }
        if max_geometry_image_uniforms != 0 {
            geometry_shader_code.insert_str(18, "#define IMAGES\n");
        }
        if max_tesselation_control_image_uniforms != 0 {
            tesselation_control_shader_code.insert_str(18, "#define IMAGES\n");
        }
        if max_tesselation_evaluation_image_uniforms != 0 {
            tesselation_evaluation_shader_code.insert_str(18, "#define IMAGES\n");
        }

        self.result_for_combined = !does_program_link(gl, &fragment_shader_code, Some(&geometry_shader_code), Some(&tesselation_control_shader_code), Some(&tesselation_evaluation_shader_code), &vertex_shader_code);

        let all_shaders = || {
            format!(
                "Vertex shader code:\n{vertex_shader_code}\nTesselation control shader code:\n{tesselation_control_shader_code}\nTesselation evaluation shader code:\n{tesselation_evaluation_shader_code}\nGeometry shader code:\n{geometry_shader_code}\nFragment shader code:\n{fragment_shader_code}"
            )
        };
        if max_combined_image_uniforms >= max_fragment_image_uniforms + max_geometry_image_uniforms + max_tesselation_control_image_uniforms + max_tesselation_evaluation_image_uniforms + max_vertex_image_uniforms {
            self.result_for_combined = !self.result_for_combined;
            if !self.result_for_combined {
                log::info!("There was an error while building a program. {}", all_shaders());
            }
        } else if !self.result_for_combined {
            log::info!("Program which exceeds limit of GL_MAX_COMBINED_IMAGE_UNIFORMS was linked successfully. {}", all_shaders());
        }
        Ok(())
    }
}

impl Subcase for ImageLoadStoreUniformLimitsTest {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        log::info!("This test tries to build invalid programs, expect error messages about exceeded number of active image uniforms");

        self.test_fragment_shader_stage(gl);
        self.test_geometry_shader_stage(gl);
        self.test_tesselation_control_shader_stage(gl);
        self.test_tesselation_evaluation_shader_stage(gl);
        self.test_vertex_shader_stage(gl);
        self.test_combined_shader_stages(gl)?;

        if !self.result_for_combined
            || !self.result_for_fragment_shader
            || !self.result_for_geometry_shader
            || !self.result_for_tesselation_control_shader
            || !self.result_for_tesselatioon_evaluation_shader
            || !self.result_for_vertex_shader
        {
            return Ok(ERROR);
        }
        Ok(NO_ERROR)
    }
}
