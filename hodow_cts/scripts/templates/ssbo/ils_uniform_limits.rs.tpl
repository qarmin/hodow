        let tesselation_control_shader_code = @LITDECL(11248);
        let tesselation_evaluation_shader_code = @LITDECL(11272);
        let vertex_shader_code = @LITDECL(11284);
        self.result_for_tesselation_control_shader = !does_program_link(gl, fragment_shader_code, None, Some(tesselation_control_shader_code), Some(tesselation_evaluation_shader_code), vertex_shader_code);
        if !self.result_for_tesselation_control_shader {
            log::info!("Program which exceeds limit of GL_MAX_TESS_CONTROL_IMAGE_UNIFORMS was linked successfully. Shader code:\n{tesselation_control_shader_code}");
        }
    }

    fn test_tesselation_evaluation_shader_stage(&mut self, gl: &glw::Functions) {
        let fragment_shader_code = @LITDECL(11316);
        let tesselation_evaluation_shader_code = @LITDECL(11326);
        let vertex_shader_code = @LITDECL(11350);
        self.result_for_tesselatioon_evaluation_shader = !does_program_link(gl, fragment_shader_code, None, None, Some(tesselation_evaluation_shader_code), vertex_shader_code);
        if !self.result_for_tesselatioon_evaluation_shader {
