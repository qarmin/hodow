        gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, 2, self.storage_buffer[2]));
        ssbo_data(gl, &data, glw::GL_STATIC_DRAW);
        // vertex buffer: vec2 position followed by an int object id
        let mut data = vec![0u8; 16 * 12];
        for object_id in 0..4usize {
            for (corner, (x, y)) in [(-0.4f32, -0.4f32), (0.4, -0.4), (-0.4, 0.4), (0.4, 0.4)].into_iter().enumerate() {
