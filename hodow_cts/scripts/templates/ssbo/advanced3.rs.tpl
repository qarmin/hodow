/// The initial contents of the seven buffers of AdvancedUsageSync, bound at the index they have in the table.
const SYNC_INITIAL: [&[GLint]; 7] = [&[0, 1, 0, 2], &[3, 1], &[2, 4], &[0], &[0, 1, 0, 2], &[3, 1], &[2, 4]];
const SYNC_REFERENCE: [&[GLint]; 7] = [&[4, 1, 4, 2], &[3, 5], &[2, 10], &[6], &[4, 1, 4, 2], &[3, 5], &[2, 10]];

fn init_sync_buffers(gl: &glw::Functions, storage_buffer: &mut [GLuint; 7]) {
    gl!(gl.gen_buffers(7, storage_buffer.as_mut_ptr()));
    for (i, data) in SYNC_INITIAL.iter().enumerate() {
        gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, i as GLuint, storage_buffer[i]));
        ssbo_data(gl, data, glw::GL_DYNAMIC_COPY);
    }
}

fn check_sync_buffer(gl: &glw::Functions, storage_buffer: &[GLuint; 7], index: usize, mapped: bool) -> bool {
    let reference = SYNC_REFERENCE[index];
    gl!(gl.bind_buffer(glw::GL_SHADER_STORAGE_BUFFER, storage_buffer[index]));
    check_values::<GLint>(gl, &format!("[Buffer{index}] Data"), 0, reference.len(), mapped, |i| reference[i])
}

fn check_sync_buffers(gl: &glw::Functions, storage_buffer: &[GLuint; 7], mapped: bool) -> bool {
    (0..7).all(|index| check_sync_buffer(gl, storage_buffer, index, mapped))
}

