impl AdvancedReadWriteCase1Cs {
    fn fill(base: GLint) -> [GLint; 128 * 4] {
        let mut data = [0 as GLint; 128 * 4];
        for i in 0..128 {
            data[i * 4] = i as GLint + base;
        }
        data
    }

    fn check(out_data: &[GLint], data: &[GLint; 128 * 4], verbose: bool) -> bool {
        let mut status = true;
        for i in 0..128 {
            if out_data[i * 4 + 3] != data[i * 4] {
                if verbose {
                    log::info!("Received: {}, but expected: {} -> {} -> {}", out_data[i * 4 + 3], data[i * 4], out_data[i * 4 + 1], out_data[i * 4 + 2]);
                } else {
                    log::info!("Received: {}, but expected: {}", out_data[i * 4 + 3], data[i * 4]);
                }
                status = false;
            }
        }
        status
    }
}

impl Subcase for AdvancedReadWriteCase1Cs {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        let mut status = true;
        let glsl_cs = @LITDECL(6888);
        self.program = create_program_cs(gl, glsl_cs);
        gl!(gl.link_program(self.program));
        if !check_program(gl, self.program) {
            return Ok(ERROR);
        }

        gl!(gl.gen_buffers(1, &mut self.storage_buffer));
        gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, 0, self.storage_buffer));
        let data = Self::fill(256);
        ssbo_data(gl, &data, glw::GL_DYNAMIC_DRAW);

        gl!(gl.use_program(self.program));
        gl!(gl.dispatch_compute(1, 1, 1));
        gl!(gl.memory_barrier(glw::GL_BUFFER_UPDATE_BARRIER_BIT));
        let Some(out_data) = map_read::<GLint>(gl, 0, 128 * 4) else {
            return Ok(ERROR);
        };
        status &= Self::check(&out_data, &data, true);
        unmap(gl);

        let data = Self::fill(512);
        ssbo_data(gl, &data, glw::GL_DYNAMIC_DRAW);
        gl!(gl.dispatch_compute(1, 1, 1));
        gl!(gl.memory_barrier(glw::GL_BUFFER_UPDATE_BARRIER_BIT));
        let Some(out_data) = map_read::<GLint>(gl, 0, 128 * 4) else {
            return Ok(ERROR);
        };
        status &= Self::check(&out_data, &data, false);

        Ok(if status { NO_ERROR } else { ERROR })
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.use_program(0));
        gl!(gl.delete_program(self.program));
        gl!(gl.delete_buffers(1, &self.storage_buffer));
        Ok(NO_ERROR)
    }
