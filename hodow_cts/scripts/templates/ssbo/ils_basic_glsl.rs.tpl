/// 1.4.1 BasicGLSLMisc
#[derive(Default)]
pub(super) struct BasicGlslMisc {
    texture: GLuint,
    program: GLuint,
    vao: GLuint,
    vbo: GLuint,
}

impl Subcase for BasicGlslMisc {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        const K_SIZE: i32 = 32;
        let data = vec![[0.0f32; 4]; (K_SIZE * K_SIZE * 4) as usize];
        gl!(gl.gen_textures(1, &mut self.texture));
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D_ARRAY, self.texture));
        gl!(gl.tex_parameteri(glw::GL_TEXTURE_2D_ARRAY, glw::GL_TEXTURE_MIN_FILTER, glw::GL_LINEAR as GLint));
        gl!(gl.tex_image_3d(glw::GL_TEXTURE_2D_ARRAY, 0, glw::GL_RGBA32F as GLint, K_SIZE, K_SIZE, 4, 0, glw::GL_RGBA, glw::GL_FLOAT, data.as_ptr().cast()));
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D_ARRAY, 0));

        let src_vs = @LITDECL(4831);
        let src_fs = @LITDECL(4833);
        self.program = build_program(gl, Some(src_vs), Some(src_fs));
        create_full_viewport_quad(gl, &mut self.vao, &mut self.vbo, None);

        gl!(gl.bind_image_texture(0, self.texture, 0, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_RGBA32F));
        gl!(gl.bind_image_texture(1, self.texture, 0, glw::FALSE, 1, glw::GL_READ_ONLY, glw::GL_RGBA32F));

        gl!(gl.clear(glw::GL_COLOR_BUFFER_BIT));
        gl!(gl.viewport(0, 0, K_SIZE, K_SIZE));
        gl!(gl.use_program(self.program));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_image_layer0"), 0));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_image_layer1"), 1));
        gl!(gl.bind_vertex_array(self.vao));
        gl!(gl.draw_arrays(glw::GL_TRIANGLE_STRIP, 0, 4));

        if !validate_read_buffer(context, 0, 0, K_SIZE, K_SIZE, &[0.0, 1.0, 0.0, 1.0]) {
            return Ok(ERROR);
        }
        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        restore_viewport(context);
        gl!(gl.delete_textures(1, &self.texture));
        gl!(gl.delete_vertex_arrays(1, &self.vao));
        gl!(gl.delete_buffers(1, &self.vbo));
        gl!(gl.use_program(0));
        gl!(gl.delete_program(self.program));
        Ok(NO_ERROR)
    }
}

/// 1.4.2 BasicGLSLEarlyFragTests
#[derive(Default)]
pub(super) struct BasicGlslEarlyFragTests {
    texture: [GLuint; 2],
    program: [GLuint; 2],
    vao: GLuint,
    vbo: GLuint,
}

impl Subcase for BasicGlslEarlyFragTests {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        let ds = context.render_target().depth_bits;
        const K_SIZE: i32 = 32;
        let mut data = vec![[0.0f32; 4]; (K_SIZE * K_SIZE) as usize];
        gl!(gl.gen_textures(2, self.texture.as_mut_ptr()));
        for texture in self.texture {
            gl!(gl.bind_texture(glw::GL_TEXTURE_2D, texture));
            gl!(gl.tex_parameteri(glw::GL_TEXTURE_2D, glw::GL_TEXTURE_MIN_FILTER, glw::GL_LINEAR as GLint));
            gl!(gl.tex_image_2d(glw::GL_TEXTURE_2D, 0, glw::GL_RGBA32F as GLint, K_SIZE, K_SIZE, 0, glw::GL_RGBA, glw::GL_FLOAT, data.as_ptr().cast()));
            gl!(gl.bind_texture(glw::GL_TEXTURE_2D, 0));
        }

        let glsl_vs = @LITDECL(4911);
        let glsl_early_frag_tests_fs = @LITDECL(4913);
        let glsl_fs = @LITDECL(4918);
        self.program[0] = build_program(gl, Some(glsl_vs), Some(glsl_early_frag_tests_fs));
        self.program[1] = build_program(gl, Some(glsl_vs), Some(glsl_fs));
        create_full_viewport_quad(gl, &mut self.vao, &mut self.vbo, None);

        gl!(gl.bind_image_texture(0, self.texture[0], 0, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_RGBA32F));
        gl!(gl.bind_image_texture(1, self.texture[1], 0, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_RGBA32F));

        gl!(gl.viewport(0, 0, K_SIZE, K_SIZE));
        gl!(gl.bind_vertex_array(self.vao));
        gl!(gl.enable(glw::GL_DEPTH_TEST));
        gl!(gl.clear_color(0.0, 1.0, 0.0, 1.0));
        gl!(gl.clear_depthf(0.0));
        gl!(gl.clear(glw::GL_COLOR_BUFFER_BIT | glw::GL_DEPTH_BUFFER_BIT));

        gl!(gl.use_program(self.program[0]));
        gl!(gl.uniform_1i(uniform_location(gl, self.program[0], "g_image"), 0));
        gl!(gl.draw_arrays(glw::GL_TRIANGLE_STRIP, 0, 4));

        gl!(gl.clear(glw::GL_COLOR_BUFFER_BIT | glw::GL_DEPTH_BUFFER_BIT));
        gl!(gl.use_program(self.program[1]));
        gl!(gl.uniform_1i(uniform_location(gl, self.program[1], "g_image"), 1));
        gl!(gl.draw_arrays(glw::GL_TRIANGLE_STRIP, 0, 4));

        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, self.texture[0]));
        gl!(gl.memory_barrier(glw::GL_TEXTURE_UPDATE_BARRIER_BIT));
        gl!(gl.get_tex_image(glw::GL_TEXTURE_2D, 0, glw::GL_RGBA, glw::GL_FLOAT, data.as_mut_ptr().cast()));
        for texel in &data {
            if is_equal(texel, &[1.0; 4]) && ds != 0 {
                return Ok(ERROR);
            }
        }

        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, self.texture[1]));
        gl!(gl.memory_barrier(glw::GL_TEXTURE_UPDATE_BARRIER_BIT));
        gl!(gl.get_tex_image(glw::GL_TEXTURE_2D, 0, glw::GL_RGBA, glw::GL_FLOAT, data.as_mut_ptr().cast()));
        for texel in &data {
            if !is_equal(texel, &[1.0; 4]) && ds != 0 {
                return Ok(ERROR);
            }
        }
        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.disable(glw::GL_DEPTH_TEST));
        gl!(gl.clear_color(0.0, 0.0, 0.0, 0.0));
        gl!(gl.clear_depthf(1.0));
        restore_viewport(context);
        gl!(gl.delete_textures(2, self.texture.as_ptr()));
        gl!(gl.delete_vertex_arrays(1, &self.vao));
        gl!(gl.delete_buffers(1, &self.vbo));
        gl!(gl.use_program(0));
        gl!(gl.delete_program(self.program[0]));
        gl!(gl.delete_program(self.program[1]));
        Ok(NO_ERROR)
    }
}

/// 1.4.3 BasicGLSLConst
#[derive(Default)]
pub(super) struct BasicGlslConst {
    program: GLuint,
    vao: GLuint,
    vbo: GLuint,
}

impl Subcase for BasicGlslConst {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        let is_at_least_44_context = context.context_type().supports_core(4, 4);
        let src_vs = @LITDECL(5004);
        let mut src_fs = format!("#version {} core", if is_at_least_44_context { "440" } else { "420" });
        src_fs.push_str("\nlayout(location = 0) out vec4 o_color;\nuniform int MaxImageUnits;\nuniform int MaxCombinedShaderOutputResources;\nuniform int MaxImageSamples;\nuniform int MaxVertexImageUniforms;\nuniform int MaxTessControlImageUniforms;\nuniform int MaxTessEvaluationImageUniforms;\nuniform int MaxGeometryImageUniforms;\nuniform int MaxFragmentImageUniforms;\nuniform int MaxCombinedImageUniforms;\nvoid main() {\n  o_color = vec4(0.0, 1.0, 0.0, 1.0);\n  if (gl_MaxImageUnits != MaxImageUnits) o_color = vec4(1.0, 0.0, 0.0, 0.1);");
        if is_at_least_44_context {
            src_fs.push_str("\n  if (gl_MaxCombinedShaderOutputResources != MaxCombinedShaderOutputResources) o_color = vec4(0.2, 0.0, 0.0, 0.2);");
        } else {
            src_fs.push_str("\n  if (gl_MaxCombinedImageUnitsAndFragmentOutputs != MaxCombinedShaderOutputResources) o_color = vec4(0.2, 0.0, 0.0, 0.2);");
        }
        src_fs.push_str("\n  if (gl_MaxImageSamples != MaxImageSamples) o_color = vec4(1.0, 0.0, 0.0, 0.3);\n  if (gl_MaxVertexImageUniforms != MaxVertexImageUniforms) o_color = vec4(1.0, 0.0, 0.0, 0.4);\n  if (gl_MaxTessControlImageUniforms != MaxTessControlImageUniforms) o_color = vec4(1.0, 0.0, 0.0, 0.5);\n  if (gl_MaxTessEvaluationImageUniforms != MaxTessEvaluationImageUniforms) o_color = vec4(1.0, 0.0, 0.0, 0.6);\n  if (gl_MaxGeometryImageUniforms != MaxGeometryImageUniforms) o_color = vec4(1.0, 0.0, 0.0, 0.7);\n  if (gl_MaxFragmentImageUniforms != MaxFragmentImageUniforms) o_color = vec4(1.0, 0.0, 0.0, 0.8);\n  if (gl_MaxCombinedImageUniforms != MaxCombinedImageUniforms) o_color = vec4(1.0, 0.0, 0.0, 0.9);\n}");
        self.program = build_program(gl, Some(src_vs), Some(&src_fs));
        gl!(gl.use_program(self.program));

        for (pname, name) in [
            (glw::GL_MAX_IMAGE_UNITS, "MaxImageUnits"),
            (glw::GL_MAX_COMBINED_SHADER_OUTPUT_RESOURCES, "MaxCombinedShaderOutputResources"),
            (glw::GL_MAX_IMAGE_SAMPLES, "MaxImageSamples"),
            (glw::GL_MAX_VERTEX_IMAGE_UNIFORMS, "MaxVertexImageUniforms"),
            (glw::GL_MAX_TESS_CONTROL_IMAGE_UNIFORMS, "MaxTessControlImageUniforms"),
            (glw::GL_MAX_TESS_EVALUATION_IMAGE_UNIFORMS, "MaxTessEvaluationImageUniforms"),
            (glw::GL_MAX_GEOMETRY_IMAGE_UNIFORMS, "MaxGeometryImageUniforms"),
            (glw::GL_MAX_FRAGMENT_IMAGE_UNIFORMS, "MaxFragmentImageUniforms"),
            (glw::GL_MAX_COMBINED_IMAGE_UNIFORMS, "MaxCombinedImageUniforms"),
        ] {
            let value = get_integer(gl, pname);
            gl!(gl.uniform_1i(uniform_location(gl, self.program, name), value));
        }

        create_full_viewport_quad(gl, &mut self.vao, &mut self.vbo, None);
        gl!(gl.clear(glw::GL_COLOR_BUFFER_BIT));
        gl!(gl.bind_vertex_array(self.vao));
        gl!(gl.draw_arrays(glw::GL_TRIANGLE_STRIP, 0, 4));

        if !validate_window(context, &[0.0, 1.0, 0.0, 1.0]) {
            return Ok(ERROR);
        }
        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.delete_vertex_arrays(1, &self.vao));
        gl!(gl.delete_buffers(1, &self.vbo));
        gl!(gl.use_program(0));
        gl!(gl.delete_program(self.program));
        Ok(NO_ERROR)
    }
}
