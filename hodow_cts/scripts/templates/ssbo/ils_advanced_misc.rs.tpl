/// 2.2.1 AdvancedAllStagesOneImage
#[derive(Default)]
pub(super) struct AdvancedAllStagesOneImage {
    program: GLuint,
    vao: GLuint,
    vbo: GLuint,
    ebo: GLuint,
    buffer: GLuint,
    buffer_tex: GLuint,
    texture: GLuint,
}

impl Subcase for AdvancedAllStagesOneImage {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        if !supported_in_geom_stages(gl, 2) {
            return Ok(NOT_SUPPORTED);
        }
        let glsl_vs = @LITDECL(5692);
        let glsl_tcs = @LITDECL(5698);
        let glsl_tes = @LITDECL(5706);
        let glsl_gs = @LITDECL(5712);
        let glsl_fs = @LITDECL(5718);
        self.program = build_program_5(gl, Some(glsl_vs), Some(glsl_tcs), Some(glsl_tes), Some(glsl_gs), Some(glsl_fs), None);
        gl!(gl.use_program(self.program));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_buffer"), 0));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_image"), 1));

        create_full_viewport_quad(gl, &mut self.vao, &mut self.vbo, Some(&mut self.ebo));

        let mut i32_value: GLint = 0;
        gl!(gl.gen_buffers(1, &mut self.buffer));
        gl!(gl.bind_buffer(glw::GL_TEXTURE_BUFFER, self.buffer));
        gl!(gl.buffer_data(glw::GL_TEXTURE_BUFFER, 4, (&i32_value as *const GLint).cast(), glw::GL_STATIC_DRAW));
        gl!(gl.bind_buffer(glw::GL_TEXTURE_BUFFER, 0));

        gl!(gl.gen_textures(1, &mut self.buffer_tex));
        gl!(gl.bind_texture(glw::GL_TEXTURE_BUFFER, self.buffer_tex));
        gl!(gl.tex_buffer(glw::GL_TEXTURE_BUFFER, glw::GL_R32I, self.buffer));
        gl!(gl.bind_texture(glw::GL_TEXTURE_BUFFER, 0));

        let mut ui32: GLuint = 0;
        gl!(gl.gen_textures(1, &mut self.texture));
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, self.texture));
        gl!(gl.tex_parameteri(glw::GL_TEXTURE_2D, glw::GL_TEXTURE_MIN_FILTER, glw::GL_NEAREST as GLint));
        gl!(gl.tex_parameteri(glw::GL_TEXTURE_2D, glw::GL_TEXTURE_MIN_FILTER, glw::GL_NEAREST as GLint));
        gl!(gl.tex_image_2d(glw::GL_TEXTURE_2D, 0, glw::GL_R32UI as GLint, 1, 1, 0, glw::GL_RED_INTEGER, glw::GL_UNSIGNED_INT, (&ui32 as *const GLuint).cast()));
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, 0));

        gl!(gl.bind_image_texture(0, self.buffer_tex, 0, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_R32I));
        gl!(gl.bind_image_texture(1, self.texture, 0, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_R32UI));

        gl!(gl.bind_vertex_array(self.vao));
        gl!(gl.patch_parameteri(glw::GL_PATCH_VERTICES, 1));
        gl!(gl.draw_elements_instanced_base_vertex(glw::GL_PATCHES, 1, glw::GL_UNSIGNED_SHORT, std::ptr::null(), 1, 0));
        gl!(gl.draw_elements_instanced(glw::GL_PATCHES, 1, glw::GL_UNSIGNED_SHORT, std::ptr::null(), 1));

        gl!(gl.memory_barrier(glw::GL_BUFFER_UPDATE_BARRIER_BIT));
        gl!(gl.bind_buffer(glw::GL_TEXTURE_BUFFER, self.buffer));
        gl!(gl.get_buffer_sub_data(glw::GL_TEXTURE_BUFFER, 0, 4, (&mut i32_value as *mut GLint).cast()));
        if !(20..=50).contains(&i32_value) {
            log::info!("Buffer value is {i32_value} should be in the range [20;50]");
            return Ok(ERROR);
        }

        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, self.texture));
        gl!(gl.get_tex_image(glw::GL_TEXTURE_2D, 0, glw::GL_RED_INTEGER, glw::GL_UNSIGNED_INT, (&mut ui32 as *mut GLuint).cast()));
        if ui32 < 40 || ui32 != (2 * i32_value) as GLuint {
            log::info!("Texture value is {ui32} should be {}", 2 * i32_value);
            return Ok(ERROR);
        }
        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.patch_parameteri(glw::GL_PATCH_VERTICES, 3));
        gl!(gl.use_program(0));
        gl!(gl.delete_buffers(1, &self.buffer));
        gl!(gl.delete_buffers(1, &self.vbo));
        gl!(gl.delete_buffers(1, &self.ebo));
        gl!(gl.delete_textures(1, &self.buffer_tex));
        gl!(gl.delete_textures(1, &self.texture));
        gl!(gl.delete_program(self.program));
        gl!(gl.delete_vertex_arrays(1, &self.vao));
        Ok(NO_ERROR)
    }
}

/// 2.3.1 AdvancedMemoryDependentInvocation
#[derive(Default)]
pub(super) struct AdvancedMemoryDependentInvocation {
    buffer: GLuint,
    buffer_tex: GLuint,
    texture: GLuint,
    program: GLuint,
    vao: GLuint,
    vbo: GLuint,
}

impl Subcase for AdvancedMemoryDependentInvocation {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        if !supported_in_vs(gl, 2) {
            return Ok(NOT_SUPPORTED);
        }
        let glsl_vs = @LITDECL(5822);
        let glsl_fs = @LITDECL(5829);
        self.program = build_program(gl, Some(glsl_vs), Some(glsl_fs));
        gl!(gl.use_program(self.program));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_buffer"), 0));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_image"), 1));

        let zero = [0.0f32; 4];
        gl!(gl.gen_buffers(1, &mut self.buffer));
        gl!(gl.bind_buffer(glw::GL_TEXTURE_BUFFER, self.buffer));
        gl!(gl.buffer_data(glw::GL_TEXTURE_BUFFER, 16, zero.as_ptr().cast(), glw::GL_STATIC_DRAW));
        gl!(gl.bind_buffer(glw::GL_TEXTURE_BUFFER, 0));

        gl!(gl.gen_textures(1, &mut self.buffer_tex));
        gl!(gl.bind_texture(glw::GL_TEXTURE_BUFFER, self.buffer_tex));
        gl!(gl.tex_buffer(glw::GL_TEXTURE_BUFFER, glw::GL_RGBA32F, self.buffer));
        gl!(gl.bind_texture(glw::GL_TEXTURE_BUFFER, 0));

        gl!(gl.gen_textures(1, &mut self.texture));
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, self.texture));
        gl!(gl.tex_parameteri(glw::GL_TEXTURE_2D, glw::GL_TEXTURE_MIN_FILTER, glw::GL_LINEAR as GLint));
        gl!(gl.tex_image_2d(glw::GL_TEXTURE_2D, 0, glw::GL_RGBA32F as GLint, 1, 1, 0, glw::GL_RGBA, glw::GL_FLOAT, zero.as_ptr().cast()));
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, 0));

        gl!(gl.bind_image_texture(0, self.buffer_tex, 0, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_RGBA32F));
        gl!(gl.bind_image_texture(1, self.texture, 0, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_RGBA32F));

        create_full_viewport_quad(gl, &mut self.vao, &mut self.vbo, None);
        gl!(gl.clear(glw::GL_COLOR_BUFFER_BIT));
        gl!(gl.bind_vertex_array(self.vao));
        gl!(gl.draw_arrays_instanced_base_instance(glw::GL_TRIANGLE_STRIP, 0, 4, 1, 0));

        if !validate_window(context, &[0.0, 1.0, 0.0, 1.0]) {
            return Ok(ERROR);
        }
        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.use_program(0));
        gl!(gl.delete_buffers(1, &self.vbo));
        gl!(gl.delete_buffers(1, &self.buffer));
        gl!(gl.delete_textures(1, &self.texture));
        gl!(gl.delete_textures(1, &self.buffer_tex));
        gl!(gl.delete_program(self.program));
        gl!(gl.delete_vertex_arrays(1, &self.vao));
        Ok(NO_ERROR)
    }
}

/// 2.3.2 AdvancedMemoryOrder
#[derive(Default)]
pub(super) struct AdvancedMemoryOrder {
    buffer: GLuint,
    buffer_tex: GLuint,
    texture: GLuint,
    program: GLuint,
    vao: GLuint,
    vbo: GLuint,
}

impl Subcase for AdvancedMemoryOrder {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        if !supported_in_vs(gl, 1) {
            return Ok(NOT_SUPPORTED);
        }
        let glsl_vs = @LITDECL(5912);
        let glsl_fs = @LITDECL(5919);
        self.program = build_program(gl, Some(glsl_vs), Some(glsl_fs));
        gl!(gl.use_program(self.program));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_buffer"), 0));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_image"), 1));

        gl!(gl.gen_buffers(1, &mut self.buffer));
        gl!(gl.bind_buffer(glw::GL_TEXTURE_BUFFER, self.buffer));
        gl!(gl.buffer_data(glw::GL_TEXTURE_BUFFER, 16 * 4, std::ptr::null(), glw::GL_STATIC_DRAW));
        gl!(gl.bind_buffer(glw::GL_TEXTURE_BUFFER, 0));

        gl!(gl.gen_textures(1, &mut self.buffer_tex));
        gl!(gl.bind_texture(glw::GL_TEXTURE_BUFFER, self.buffer_tex));
        gl!(gl.tex_buffer(glw::GL_TEXTURE_BUFFER, glw::GL_RGBA32F, self.buffer));
        gl!(gl.bind_texture(glw::GL_TEXTURE_BUFFER, 0));

        let (width, height) = scale_dimensions_to_memory(window_size(context), 1, 2, 16, 16);
        let data = vec![[0.0f32; 4]; (width * height) as usize];
        gl!(gl.gen_textures(1, &mut self.texture));
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, self.texture));
        gl!(gl.tex_parameteri(glw::GL_TEXTURE_2D, glw::GL_TEXTURE_MIN_FILTER, glw::GL_LINEAR as GLint));
        gl!(gl.tex_image_2d(glw::GL_TEXTURE_2D, 0, glw::GL_RGBA32F as GLint, width, height, 0, glw::GL_RGBA, glw::GL_FLOAT, data.as_ptr().cast()));
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, 0));

        gl!(gl.bind_image_texture(0, self.buffer_tex, 0, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_RGBA32F));
        gl!(gl.bind_image_texture(1, self.texture, 0, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_RGBA32F));

        create_full_viewport_quad(gl, &mut self.vao, &mut self.vbo, None);
        gl!(gl.clear(glw::GL_COLOR_BUFFER_BIT));
        gl!(gl.viewport(0, 0, width, height));
        gl!(gl.bind_vertex_array(self.vao));
        gl!(gl.draw_arrays_instanced_base_instance(glw::GL_TRIANGLE_STRIP, 0, 4, 1, 0));

        if !validate_read_buffer(context, 0, 0, width, height, &[0.0, 1.0, 0.0, 1.0]) {
            return Ok(ERROR);
        }
        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        restore_viewport(context);
        gl!(gl.use_program(0));
        gl!(gl.delete_buffers(1, &self.vbo));
        gl!(gl.delete_buffers(1, &self.buffer));
        gl!(gl.delete_textures(1, &self.texture));
        gl!(gl.delete_textures(1, &self.buffer_tex));
        gl!(gl.delete_program(self.program));
        gl!(gl.delete_vertex_arrays(1, &self.vao));
        Ok(NO_ERROR)
    }
}
