/// 2.1.7 AdvancedSyncBufferUpdate
#[derive(Default)]
pub(super) struct AdvancedSyncBufferUpdate {
    buffer: GLuint,
    buffer_tex: GLuint,
    store_program: GLuint,
    attribless_vao: GLuint,
}

impl Subcase for AdvancedSyncBufferUpdate {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        if !supported_in_vs(gl, 1) {
            return Ok(NOT_SUPPORTED);
        }
        let glsl_store_vs = @LITDECL(5612);
        self.store_program = build_program(gl, Some(glsl_store_vs), None);

        gl!(gl.gen_vertex_arrays(1, &mut self.attribless_vao));
        gl!(gl.bind_vertex_array(self.attribless_vao));

        gl!(gl.gen_buffers(1, &mut self.buffer));
        gl!(gl.bind_buffer(glw::GL_TEXTURE_BUFFER, self.buffer));
        gl!(gl.buffer_data(glw::GL_TEXTURE_BUFFER, 16 * 1000, std::ptr::null(), glw::GL_DYNAMIC_DRAW));
        gl!(gl.bind_buffer(glw::GL_TEXTURE_BUFFER, 0));

        gl!(gl.gen_textures(1, &mut self.buffer_tex));
        gl!(gl.bind_texture(glw::GL_TEXTURE_BUFFER, self.buffer_tex));
        gl!(gl.tex_buffer(glw::GL_TEXTURE_BUFFER, glw::GL_RGBA32F, self.buffer));

        gl!(gl.bind_image_texture(0, self.buffer_tex, 0, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_RGBA32F));

        gl!(gl.enable(glw::GL_RASTERIZER_DISCARD));
        gl!(gl.use_program(self.store_program));
        gl!(gl.draw_arrays(glw::GL_POINTS, 0, 1000));

        gl!(gl.memory_barrier(glw::GL_BUFFER_UPDATE_BARRIER_BIT));
        gl!(gl.bind_buffer(glw::GL_TEXTURE_BUFFER, self.buffer));
        let ptr: *const [f32; 4] = gl!(gl.map_buffer_range(glw::GL_TEXTURE_BUFFER, 0, 1000 * 16, glw::GL_MAP_READ_BIT)).cast();
        if ptr.is_null() {
            return Ok(ERROR);
        }
        // SAFETY: the mapping covers 1000 vec4 values and stays mapped until the buffer is deleted.
        let values = unsafe { std::slice::from_raw_parts(ptr, 1000) };
        for (i, value) in values.iter().enumerate() {
            if !is_equal(value, &[i as f32; 4]) {
                log::info!("Bad buffer value found at index {i}");
                return Ok(ERROR);
            }
        }
        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.disable(glw::GL_RASTERIZER_DISCARD));
        gl!(gl.use_program(0));
        gl!(gl.delete_buffers(1, &self.buffer));
        gl!(gl.delete_textures(1, &self.buffer_tex));
        gl!(gl.delete_program(self.store_program));
        gl!(gl.delete_vertex_arrays(1, &self.attribless_vao));
        Ok(NO_ERROR)
    }
}
