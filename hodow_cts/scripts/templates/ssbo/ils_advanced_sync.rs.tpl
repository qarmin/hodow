        gl!(gl.gen_buffers(1, &mut self.pbo));
        gl!(gl.bind_buffer(glw::GL_PIXEL_UNPACK_BUFFER, self.pbo));
        gl!(gl.buffer_data(glw::GL_PIXEL_UNPACK_BUFFER, 16 * 16 * 16, data.as_ptr().cast(), glw::GL_DYNAMIC_READ));
