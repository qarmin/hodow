/// 2.5 AdvancedCopyImage
#[derive(Default)]
pub(super) struct AdvancedCopyImage {
    texture: [GLuint; 2],
    program: GLuint,
    vao: GLuint,
    vbo: GLuint,
    ebo: GLuint,
}

impl Subcase for AdvancedCopyImage {
    fn setup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.gen_textures(2, self.texture.as_mut_ptr()));
        create_full_viewport_quad(gl, &mut self.vao, &mut self.vbo, Some(&mut self.ebo));
        let glsl_vs = @LITDECL(6467);
        let glsl_fs = @LITDECL(6469);
        self.program = build_program(gl, Some(glsl_vs), Some(glsl_fs));
        Ok(NO_ERROR)
    }

    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        let (width, height) = scale_dimensions_to_memory(window_size(context), 2, 2, 16, 16);

        gl!(gl.use_program(self.program));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_input_image"), 0));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_output_image"), 1));

        let data = vec![[7.0f32; 4]; (width * height) as usize];
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, self.texture[0]));
        gl!(gl.tex_parameteri(glw::GL_TEXTURE_2D, glw::GL_TEXTURE_MIN_FILTER, glw::GL_LINEAR as GLint));
        gl!(gl.tex_image_2d(glw::GL_TEXTURE_2D, 0, glw::GL_RGBA32F as GLint, width, height, 0, glw::GL_RGBA, glw::GL_FLOAT, data.as_ptr().cast()));
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, self.texture[1]));
        gl!(gl.tex_parameteri(glw::GL_TEXTURE_2D, glw::GL_TEXTURE_MIN_FILTER, glw::GL_LINEAR as GLint));
        gl!(gl.tex_image_2d(glw::GL_TEXTURE_2D, 0, glw::GL_RGBA32F as GLint, width, height, 0, glw::GL_RGBA, glw::GL_FLOAT, std::ptr::null()));
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, 0));

        gl!(gl.bind_image_texture(0, self.texture[0], 0, glw::FALSE, 0, glw::GL_READ_ONLY, glw::GL_RGBA32F));
        gl!(gl.bind_image_texture(1, self.texture[1], 0, glw::FALSE, 0, glw::GL_WRITE_ONLY, glw::GL_RGBA32F));

        gl!(gl.clear(glw::GL_COLOR_BUFFER_BIT));
        gl!(gl.viewport(0, 0, width, height));
        gl!(gl.bind_vertex_array(self.vao));
        gl!(gl.draw_elements_instanced_base_instance(glw::GL_TRIANGLE_STRIP, 4, glw::GL_UNSIGNED_SHORT, std::ptr::null(), 1, 0));

        gl!(gl.memory_barrier(glw::GL_TEXTURE_UPDATE_BARRIER_BIT));
        let mut rdata = vec![[0.0f32; 4]; (width * height) as usize];
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, self.texture[1]));
        gl!(gl.get_tex_image(glw::GL_TEXTURE_2D, 0, glw::GL_RGBA, glw::GL_FLOAT, rdata.as_mut_ptr().cast()));
        if rdata.iter().any(|texel| !is_equal(texel, &[7.0; 4])) {
            return Ok(ERROR);
        }
        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        restore_viewport(context);
        gl!(gl.use_program(0));
        gl!(gl.delete_buffers(1, &self.vbo));
        gl!(gl.delete_buffers(1, &self.ebo));
        gl!(gl.delete_textures(2, self.texture.as_ptr()));
        gl!(gl.delete_program(self.program));
        gl!(gl.delete_vertex_arrays(1, &self.vao));
        Ok(NO_ERROR)
    }
}

/// 2.6 AdvancedAllMips
#[derive(Default)]
pub(super) struct AdvancedAllMips {
    texture: GLuint,
    store_program: GLuint,
    load_program: GLuint,
    vao: GLuint,
    vbo: GLuint,
    ebo: GLuint,
}

impl Subcase for AdvancedAllMips {
    fn setup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.gen_textures(1, &mut self.texture));
        create_full_viewport_quad(gl, &mut self.vao, &mut self.vbo, Some(&mut self.ebo));
        let glsl_vs = @LITDECL(6553);
        let glsl_store_fs = @LITDECL(6555);
        let glsl_load_fs = @LITDECL(6559);
        self.store_program = build_program(gl, Some(glsl_vs), Some(glsl_store_fs));
        self.load_program = build_program(gl, Some(glsl_vs), Some(glsl_load_fs));
        Ok(NO_ERROR)
    }

    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        for program in [self.store_program, self.load_program] {
            gl!(gl.use_program(program));
            for unit in 0..6 {
                gl!(gl.uniform_1i(uniform_location(gl, program, &format!("g_image[{unit}]")), unit));
            }
            gl!(gl.use_program(0));
        }

        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, self.texture));
        for (level, size) in [(0, 32), (1, 16), (2, 8), (3, 4), (4, 2), (5, 1)] {
            gl!(gl.tex_image_2d(glw::GL_TEXTURE_2D, level, glw::GL_RGBA32F as GLint, size, size, 0, glw::GL_RGBA, glw::GL_FLOAT, std::ptr::null()));
        }
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, 0));

        for level in 0..6 {
            gl!(gl.bind_image_texture(level as GLuint, self.texture, level, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_RGBA32F));
        }

        gl!(gl.viewport(0, 0, 32, 32));
        gl!(gl.bind_vertex_array(self.vao));
        gl!(gl.clear(glw::GL_COLOR_BUFFER_BIT));
        gl!(gl.use_program(self.store_program));
        gl!(gl.draw_elements_instanced_base_instance(glw::GL_TRIANGLE_STRIP, 4, glw::GL_UNSIGNED_SHORT, std::ptr::null(), 1, 0));

        gl!(gl.memory_barrier(glw::GL_SHADER_IMAGE_ACCESS_BARRIER_BIT));

        gl!(gl.use_program(self.load_program));
        gl!(gl.draw_elements_instanced_base_vertex(glw::GL_TRIANGLE_STRIP, 4, glw::GL_UNSIGNED_SHORT, std::ptr::null(), 1, 0));

        if !validate_read_buffer(context, 0, 0, 32, 32, &[0.0, 1.0, 0.0, 1.0]) {
            return Ok(ERROR);
        }
        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        restore_viewport(context);
        gl!(gl.use_program(0));
        gl!(gl.delete_buffers(1, &self.vbo));
        gl!(gl.delete_buffers(1, &self.ebo));
        gl!(gl.delete_textures(1, &self.texture));
        gl!(gl.delete_program(self.store_program));
        gl!(gl.delete_program(self.load_program));
        gl!(gl.delete_vertex_arrays(1, &self.vao));
        Ok(NO_ERROR)
    }
}

/// 2.7 AdvancedCast
#[derive(Default)]
pub(super) struct AdvancedCast {
    texture: [GLuint; 2],
    program: GLuint,
    vao: GLuint,
    vbo: GLuint,
    ebo: GLuint,
}

impl AdvancedCast {
    /// Every texel of the bound level 0 read back as RGBA8 must be `expected`.
    fn texels_equal(gl: &glw::Functions, width: i32, height: i32, expected: [u8; 4]) -> bool {
        let mut data = vec![0u8; (width * height * 4) as usize];
        gl!(gl.get_tex_image(glw::GL_TEXTURE_2D, 0, glw::GL_RGBA, glw::GL_UNSIGNED_BYTE, data.as_mut_ptr().cast()));
        for texel in data.chunks(4) {
            if texel != expected {
                log::info!("Color is ({} {}{} {}) should be ({} {} {} {})", texel[0], texel[1], texel[2], texel[3], expected[0], expected[1], expected[2], expected[3]);
                return false;
            }
        }
        true
    }
}

impl Subcase for AdvancedCast {
    fn setup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.gen_textures(2, self.texture.as_mut_ptr()));
        create_full_viewport_quad(gl, &mut self.vao, &mut self.vbo, Some(&mut self.ebo));
        let glsl_vs = @LITDECL(6653);
        let glsl_fs = @LITDECL(6655);
        self.program = build_program(gl, Some(glsl_vs), Some(glsl_fs));
        Ok(NO_ERROR)
    }

    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        let (width, height) = window_size(context);

        gl!(gl.use_program(self.program));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_image0"), 0));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_image1"), 1));

        let data = vec![0u8; (width * height * 4) as usize];
        for texture in self.texture {
            gl!(gl.bind_texture(glw::GL_TEXTURE_2D, texture));
            gl!(gl.tex_parameteri(glw::GL_TEXTURE_2D, glw::GL_TEXTURE_MIN_FILTER, glw::GL_LINEAR as GLint));
            gl!(gl.tex_image_2d(glw::GL_TEXTURE_2D, 0, glw::GL_RGBA8 as GLint, width, height, 0, glw::GL_RGBA, glw::GL_UNSIGNED_BYTE, data.as_ptr().cast()));
        }
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, 0));

        gl!(gl.bind_image_texture(0, self.texture[0], 0, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_R32I));
        gl!(gl.bind_image_texture(1, self.texture[1], 0, glw::FALSE, 0, glw::GL_READ_WRITE, glw::GL_R32UI));

        gl!(gl.clear(glw::GL_COLOR_BUFFER_BIT));
        gl!(gl.bind_vertex_array(self.vao));
        gl!(gl.draw_elements_instanced_base_instance(glw::GL_TRIANGLE_STRIP, 4, glw::GL_UNSIGNED_SHORT, std::ptr::null(), 1, 0));

        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, self.texture[0]));
        gl!(gl.memory_barrier(glw::GL_TEXTURE_UPDATE_BARRIER_BIT));
        if !Self::texels_equal(gl, width, height, [1, 0, 0, 0]) {
            return Ok(ERROR);
        }
        gl!(gl.bind_texture(glw::GL_TEXTURE_2D, self.texture[1]));
        if !Self::texels_equal(gl, width, height, [3, 0, 0, 0]) {
            return Ok(ERROR);
        }

        if !validate_window(context, &[0.0, 1.0, 0.0, 1.0]) {
            return Ok(ERROR);
        }
        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.use_program(0));
        gl!(gl.delete_buffers(1, &self.vbo));
        gl!(gl.delete_buffers(1, &self.ebo));
        gl!(gl.delete_textures(2, self.texture.as_ptr()));
        gl!(gl.delete_program(self.program));
        gl!(gl.delete_vertex_arrays(1, &self.vao));
        Ok(NO_ERROR)
    }
}
