impl Subcase for AdvancedMatrix {
    fn setup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.gen_framebuffers(1, &mut self.fbo));
        gl!(gl.gen_textures(1, &mut self.rt));
