/// 4.1 NegativeUniform
#[derive(Default)]
pub(super) struct NegativeUniform {
    program: GLuint,
}

impl Subcase for NegativeUniform {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        let glsl_vs = @LITDECL(10630);
        let glsl_fs = @LITDECL(10632);
        self.program = build_program(gl, Some(glsl_vs), Some(glsl_fs));

        let max_image_units = get_integer(gl, glw::GL_MAX_IMAGE_UNITS);
        gl!(gl.use_program(self.program));
        let location = uniform_location(gl, self.program, "g_image");

        gl!(gl.uniform_1i(location, -1));
        if gl!(gl.get_error()) != glw::GL_INVALID_VALUE {
            log::info!("glUniform1i should generate INVALID_VALUE when <value> is less than zero.");
            return Ok(ERROR);
        }
        gl!(gl.uniform_1i(location, max_image_units));
        if gl!(gl.get_error()) != glw::GL_INVALID_VALUE {
            log::info!("glUniform1i should generate INVALID_VALUE when <value> is greater than or equal to the value of MAX_IMAGE_UNITS.");
            return Ok(ERROR);
        }
        let mut i: GLint = -3;
        gl!(gl.uniform_1iv(location, 1, &i));
        if gl!(gl.get_error()) != glw::GL_INVALID_VALUE {
            log::info!("glUniform1iv should generate INVALID_VALUE when <value> is less than zero.");
            return Ok(ERROR);
        }
        i = max_image_units + 1;
        gl!(gl.uniform_1iv(location, 1, &i));
        if gl!(gl.get_error()) != glw::GL_INVALID_VALUE {
            log::info!("glUniform1iv should generate INVALID_VALUE when <value> is greater than or equal to the value of MAX_IMAGE_UNITS.");
            return Ok(ERROR);
        }
        gl!(gl.uniform_1ui(location, 0));
        if gl!(gl.get_error()) != glw::GL_INVALID_OPERATION {
            log::info!("glUniform1iv should generate INVALID_OPERATION if the location refers to an image variable.");
            return Ok(ERROR);
        }
        gl!(gl.uniform_2i(location, 0, 0));
        if gl!(gl.get_error()) != glw::GL_INVALID_OPERATION {
            log::info!("glUniform2i should generate INVALID_OPERATION if the location refers to an image variable.");
            return Ok(ERROR);
        }

        gl!(gl.use_program(0));
        gl!(gl.program_uniform_1i(self.program, location, -1));
        if gl!(gl.get_error()) != glw::GL_INVALID_VALUE {
            log::info!("glProgramUniform1i should generate INVALID_VALUE when <value> is less than zero.");
            return Ok(ERROR);
        }
        gl!(gl.program_uniform_1i(self.program, location, max_image_units));
        if gl!(gl.get_error()) != glw::GL_INVALID_VALUE {
            log::info!("glProgramUniform1i should generate INVALID_VALUE when <value> is greater than or equal to the value of MAX_IMAGE_UNITS.");
            return Ok(ERROR);
        }
        let mut ii: GLint = -3;
        gl!(gl.program_uniform_1iv(self.program, location, 1, &ii));
        if gl!(gl.get_error()) != glw::GL_INVALID_VALUE {
            log::info!("glProgramUniform1iv should generate INVALID_VALUE when <value> is less than zero.");
            return Ok(ERROR);
        }
        ii = max_image_units + 1;
        gl!(gl.program_uniform_1iv(self.program, location, 1, &ii));
        if gl!(gl.get_error()) != glw::GL_INVALID_VALUE {
            log::info!("glProgramUniform1iv should generate INVALID_VALUE when <value> is greater than or equal to the value of MAX_IMAGE_UNITS.");
            return Ok(ERROR);
        }
        gl!(gl.program_uniform_1ui(self.program, location, 0));
        if gl!(gl.get_error()) != glw::GL_INVALID_OPERATION {
            log::info!("glProgramUniform1ui should generate INVALID_OPERATION if the location refers to an image variable.");
            return Ok(ERROR);
        }
        gl!(gl.program_uniform_2i(self.program, location, 0, 0));
        if gl!(gl.get_error()) != glw::GL_INVALID_OPERATION {
            log::info!("glProgramUniform2i should generate INVALID_OPERATION if the location refers to an image variable.");
            return Ok(ERROR);
        }
        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.use_program(0));
        gl!(gl.delete_program(self.program));
        Ok(NO_ERROR)
    }
}

/// 4.2 NegativeBind
#[derive(Default)]
pub(super) struct NegativeBind;

impl Subcase for NegativeBind {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.bind_image_texture(100, 0, 0, glw::FALSE, 0, glw::GL_READ_ONLY, glw::GL_RGBA));
        if gl!(gl.get_error()) != glw::GL_INVALID_VALUE {
            log::info!("BindImageTexture should generate INVALID_VALUE if <unit> is greater than or equal to the value of MAX_IMAGE_UNITS.");
            return Ok(ERROR);
        }
        gl!(gl.bind_image_texture(0, 123, 0, glw::FALSE, 0, glw::GL_READ_ONLY, glw::GL_RGBA));
        if gl!(gl.get_error()) != glw::GL_INVALID_VALUE {
            log::info!("BindImageTexture should generate INVALID_VALUE if <texture> is not the name of an existing texture object.");
            return Ok(ERROR);
        }
        gl!(gl.bind_image_texture(1, 0, 0, glw::FALSE, 0, glw::GL_READ_ONLY, glw::GL_RGBA + 1234));
        if gl!(gl.get_error()) != glw::GL_INVALID_VALUE {
            log::info!("BindImageTexture should generate INVALID_VALUE if <format> is not a legal format.");
            return Ok(ERROR);
        }
        Ok(NO_ERROR)
    }
}

/// 4.3 NegativeCompileErrors
#[derive(Default)]
pub(super) struct NegativeCompileErrors;

impl NegativeCompileErrors {
    fn compile(gl: &glw::Functions, source: &str) -> bool {
        let shader = gl!(gl.create_shader(glw::GL_FRAGMENT_SHADER));
        let source = CString::new(source).expect("shader sources hold no NUL");
        let pointer = source.as_ptr();
        gl!(gl.shader_source(shader, 1, &pointer, std::ptr::null()));
        gl!(gl.compile_shader(shader));
        let mut log_buffer = [0u8; 1024];
        gl!(gl.get_shader_info_log(shader, log_buffer.len() as glw::GLsizei, std::ptr::null_mut(), log_buffer.as_mut_ptr().cast()));
        let end = log_buffer.iter().position(|&byte| byte == 0).unwrap_or(log_buffer.len());
        log::info!("Shader Info Log:\n{}", String::from_utf8_lossy(&log_buffer[..end]));
        let mut status: GLint = 0;
        gl!(gl.get_shaderiv(shader, glw::GL_COMPILE_STATUS, &mut status));
        gl!(gl.delete_shader(shader));
        if status == glw::GL_TRUE as GLint {
            log::info!("Compilation should fail.");
            return false;
        }
        true
    }
}

impl Subcase for NegativeCompileErrors {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        let sources: [&str; 12] = [
            @LIT(10828-10830),
            @LIT(10833-10835),
            @LIT(10838-10840),
            @LIT(10843-10844),
            @LIT(10847-10849),
            @LIT(10852-10853),
            @LIT(10856-10857),
            @LIT(10860-10862),
            @LIT(10865-10867),
            @LIT(10870-10872),
            @LIT(10875-10877),
            @LIT(10880-10883),
        ];
        for source in sources {
            if !Self::compile(gl, source) {
                return Ok(ERROR);
            }
        }
        Ok(NO_ERROR)
    }
}

/// 4.4 NegativeLinkErrors
#[derive(Default)]
pub(super) struct NegativeLinkErrors;

impl NegativeLinkErrors {
    fn link(gl: &glw::Functions, vs: &str, fs: &str) -> bool {
        let program = gl!(gl.create_program());
        let mut shaders = [0 as GLuint; 2];
        for (shader, (shader_type, source)) in shaders.iter_mut().zip([(glw::GL_VERTEX_SHADER, vs), (glw::GL_FRAGMENT_SHADER, fs)]) {
            *shader = gl!(gl.create_shader(shader_type));
            gl!(gl.attach_shader(program, *shader));
            gl!(gl.delete_shader(*shader));
            let source = CString::new(source).expect("shader sources hold no NUL");
            let pointer = source.as_ptr();
            gl!(gl.shader_source(*shader, 1, &pointer, std::ptr::null()));
            gl!(gl.compile_shader(*shader));
        }

        let mut status: GLint = 0;
        gl!(gl.get_shaderiv(shaders[0], glw::GL_COMPILE_STATUS, &mut status));
        if status == glw::GL_FALSE as GLint {
            gl!(gl.delete_program(program));
            log::info!("VS compilation should be ok.");
            return false;
        }
        gl!(gl.get_shaderiv(shaders[1], glw::GL_COMPILE_STATUS, &mut status));
        if status == glw::GL_FALSE as GLint {
            gl!(gl.delete_program(program));
            log::info!("FS compilation should be ok.");
            return false;
        }

        gl!(gl.link_program(program));
        let mut log_buffer = [0u8; 1024];
        gl!(gl.get_program_info_log(program, log_buffer.len() as glw::GLsizei, std::ptr::null_mut(), log_buffer.as_mut_ptr().cast()));
        let end = log_buffer.iter().position(|&byte| byte == 0).unwrap_or(log_buffer.len());
        log::info!("Program Info Log:\n{}", String::from_utf8_lossy(&log_buffer[..end]));
        gl!(gl.get_programiv(program, glw::GL_LINK_STATUS, &mut status));
        gl!(gl.delete_program(program));
        if status == glw::GL_TRUE as GLint {
            log::info!("Link operation should fail.");
            return false;
        }
        true
    }
}

impl Subcase for NegativeLinkErrors {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        if !supported_in_vs(gl, 1) {
            return Ok(NOT_SUPPORTED);
        }
        let pairs: [(&str, &str); 2] = [(@LITS(10926-10931)), (@LITS(10934-10939))];
        for (vs, fs) in pairs {
            if !Self::link(gl, vs, fs) {
                return Ok(ERROR);
            }
        }
        Ok(NO_ERROR)
    }
}
