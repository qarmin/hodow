const MATERIALS: [f32; 16] = [1.0f32, 0.0f32, 0.0f32, 1.0f32, 0.0f32, 1.0f32, 0.0f32, 1.0f32, 0.0f32, 0.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32, 0.0f32, 1.0f32];
const TRANSLATIONS: [f32; 8] = [-0.5f32, -0.5f32, 0.5f32, -0.5f32, -0.5f32, 0.5f32, 0.5f32, 0.5f32];
const QUAD_POSITIONS: [f32; 8] = [-0.4f32, -0.4f32, 0.4f32, -0.4f32, -0.4f32, 0.4f32, 0.4f32, 0.4f32];

/// The material, material id, transform and transform id buffers of IndirectAddressingCase1, bound at 0..3.
fn init_case1_buffers(gl: &glw::Functions, storage_buffer: &[GLuint]) {
    gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, 0, storage_buffer[0]));
    ssbo_data(gl, &MATERIALS, glw::GL_DYNAMIC_DRAW);
    gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, 1, storage_buffer[1]));
    ssbo_data(gl, &[2u32, 3, 0, 2], glw::GL_DYNAMIC_DRAW);
    gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, 2, storage_buffer[2]));
    ssbo_data(gl, &TRANSLATIONS, glw::GL_DYNAMIC_DRAW);
    gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, 3, storage_buffer[3]));
    ssbo_data(gl, &[3u32, 1, 0, 2], glw::GL_DYNAMIC_DRAW);
}

/// "update material id buffer with BufferSubData" and "update transform id buffer with BufferData"
fn update_case1_buffers(gl: &glw::Functions, storage_buffer: &[GLuint]) {
    let data: [u32; 4] = [3, 2, 1, 0];
    gl!(gl.bind_buffer(glw::GL_SHADER_STORAGE_BUFFER, storage_buffer[1]));
    gl!(gl.buffer_sub_data(glw::GL_SHADER_STORAGE_BUFFER, 0, std::mem::size_of_val(&data) as isize, data.as_ptr().cast()));

    gl!(gl.bind_buffer(glw::GL_SHADER_STORAGE_BUFFER, storage_buffer[3]));
    ssbo_data(gl, &[0u32, 1, 2, 3], glw::GL_DYNAMIC_DRAW);
}

/// The vertex buffer of the unit quad and a vertex array that reads it as attribute `location`.
fn init_quad_vertex_buffer(gl: &glw::Functions, vertex_buffer: &mut GLuint) {
    gl!(gl.gen_buffers(1, vertex_buffer));
    gl!(gl.bind_buffer(glw::GL_ARRAY_BUFFER, *vertex_buffer));
    buffer_data(gl, glw::GL_ARRAY_BUFFER, &QUAD_POSITIONS, glw::GL_STATIC_DRAW);
    gl!(gl.bind_buffer(glw::GL_ARRAY_BUFFER, 0));
}

fn init_quad_vertex_array(gl: &glw::Functions, location: GLuint, vertex_buffer: GLuint, vertex_array: &mut GLuint) {
    gl!(gl.gen_vertex_arrays(1, vertex_array));
    gl!(gl.bind_vertex_array(*vertex_array));
    gl!(gl.bind_buffer(glw::GL_ARRAY_BUFFER, vertex_buffer));
    gl!(gl.vertex_attrib_pointer(location, 2, glw::GL_FLOAT, glw::FALSE, 0, std::ptr::null()));
    gl!(gl.bind_buffer(glw::GL_ARRAY_BUFFER, 0));
    gl!(gl.enable_vertex_attrib_array(location));
    gl!(gl.bind_vertex_array(0));
}

