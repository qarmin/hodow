/// 2.4.2 AdvancedIndirectAddressingCase2CS
#[derive(Default)]
pub(super) struct AdvancedIndirectAddressingCase2Cs {
    program: GLuint,
    storage_buffer: [GLuint; 5],
}

impl AdvancedIndirectAddressingCase2Cs {
    /// Each of the four output colors must equal `expected`.
    fn outputs_match(out_data: &[f32], expected: &[f32; 3]) -> bool {
        let mut status = true;
        for i in 0..4 {
            if out_data[i * 4] != expected[0] || out_data[i * 4 + 1] != expected[1] || out_data[i * 4 + 2] != expected[2] {
                log::info!("Received: {}, {}, {}, but expected: {}, {}, {}", out_data[i * 4], out_data[i * 4 + 1], out_data[i * 4 + 2], expected[0], expected[1], expected[2]);
                status = false;
            }
        }
        status
    }
}

impl Subcase for AdvancedIndirectAddressingCase2Cs {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        let blocks_c = get_integer(gl, glw::GL_MAX_COMBINED_SHADER_STORAGE_BLOCKS);
        if blocks_c < 8 {
            return Ok(NOT_SUPPORTED);
        }
        let mut status = true;
        let glsl_cs = @LITDECL(6676);
        self.program = create_program_cs(gl, glsl_cs);
        gl!(gl.link_program(self.program));
        if !check_program(gl, self.program) {
            return Ok(ERROR);
        }

        gl!(gl.gen_buffers(5, self.storage_buffer.as_mut_ptr()));

        // material buffers
        for (i, data) in CASE2_MATERIALS.iter().enumerate() {
            gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, i as GLuint, self.storage_buffer[i]));
            ssbo_data(gl, data, glw::GL_DYNAMIC_DRAW);
        }
        gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, 4, self.storage_buffer[4]));
        ssbo_alloc(gl, 4 * 4 * 4, glw::GL_STATIC_DRAW);

        gl!(gl.use_program(self.program));
        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_material_id"), 1));
        gl!(gl.dispatch_compute(1, 1, 1));
        gl!(gl.bind_buffer(glw::GL_SHADER_STORAGE_BUFFER, self.storage_buffer[4]));
        gl!(gl.memory_barrier(glw::GL_BUFFER_UPDATE_BARRIER_BIT));
        let Some(out_data) = map_read::<f32>(gl, 0, 16) else {
            return Ok(ERROR);
        };
        status &= Self::outputs_match(&out_data, &CASE2_MATERIALS[1]);
        unmap(gl);

        gl!(gl.uniform_1i(uniform_location(gl, self.program, "g_material_id"), 3));
        gl!(gl.dispatch_compute(1, 1, 1));
        gl!(gl.memory_barrier(glw::GL_BUFFER_UPDATE_BARRIER_BIT));
        let Some(out_data) = map_read::<f32>(gl, 0, 16) else {
            return Ok(ERROR);
        };
        status &= Self::outputs_match(&out_data, &CASE2_MATERIALS[3]);

        Ok(if status { NO_ERROR } else { ERROR })
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.use_program(0));
        gl!(gl.delete_program(self.program));
        gl!(gl.delete_buffers(5, self.storage_buffer.as_ptr()));
        Ok(NO_ERROR)
    }
}
