/// Compares `count` vec3 colors (stride 4 floats) and, for the second half of the table, `count` vec2 positions, as the CS case does; true when all match.
fn compare_case1_output(out_data: &[f32], expected: &[f32; 96]) -> bool {
    let mut status = true;
    for i in 0..16 {
        if out_data[i * 4] != expected[i * 4] || out_data[i * 4 + 1] != expected[i * 4 + 1] || out_data[i * 4 + 2] != expected[i * 4 + 2] {
            log::info!("Received: {}, {}, {}, but expected: {}, {}, {}", out_data[i * 4], out_data[i * 4 + 1], out_data[i * 4 + 2], expected[i * 4], expected[i * 4 + 1], expected[i * 4 + 2]);
            status = false;
        }
    }
    for i in 32..32 + 16 {
        if ((out_data[i * 2] - expected[i * 2]).abs() as f64) > 1e-6 || ((out_data[i * 2 + 1] - expected[i * 2 + 1]).abs() as f64) > 1e-6 {
            log::info!("Received: {}, {}, but expected: {}, {}", out_data[i * 2], out_data[i * 2 + 1], expected[i * 2], expected[i * 2 + 1]);
            status = false;
        }
    }
    status
}

