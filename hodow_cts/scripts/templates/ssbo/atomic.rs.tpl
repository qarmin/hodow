use super::base::*;
use crate::glu::Context;
use crate::glw::{self, GLint, GLuint};
use crate::khr_gl::subcase::{ERROR, NO_ERROR, NOT_SUPPORTED, Subcase, SubcaseResult};

fn gl_primitives_u(gl: &glw::Functions, buffer: &[GLuint], ii: usize, mapped: bool, count: usize) -> bool {
    gl!(gl.bind_buffer(glw::GL_SHADER_STORAGE_BUFFER, buffer[ii * 2]));
    if !check_values::<GLuint>(gl, "uData", 0, count, mapped, |_| 7) {
        return false;
    }
    gl!(gl.bind_buffer(glw::GL_SHADER_STORAGE_BUFFER, buffer[ii * 2 + 1]));
    check_values::<GLint>(gl, "iData", 0, count, mapped, |_| 7)
}

/// The zeroed storage buffers `count` of `elements` ints each, bound at `first_binding..`.
fn init_zero_buffers(gl: &glw::Functions, buffer: &mut [GLuint], first_binding: GLuint, elements: usize) {
    gl!(gl.gen_buffers(buffer.len() as i32, buffer.as_mut_ptr()));
    for (i, &name) in buffer.iter().enumerate() {
        let data = vec![0 as GLint; elements];
        gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, first_binding + i as GLuint, name));
        ssbo_data(gl, &data, glw::GL_DYNAMIC_DRAW);
    }
}

/// 1.8.1 BasicAtomicCase1 (VS, GS and FS)
#[derive(Default)]
pub(super) struct BasicAtomicCase1 {
    program: GLuint,
    storage_buffer: [GLuint; 6],
    vertex_array: GLuint,
    vertex_buffer: GLuint,
}

impl Subcase for BasicAtomicCase1 {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        if !supported_in_vs(gl, 2) {
            return Ok(NOT_SUPPORTED);
        }
        if !supported_in_gs(gl, 2) {
            return Ok(NOT_SUPPORTED);
        }

        let glsl_vs = @LITDECL(2224);
        let glsl_gs = @LITDECL(2250);
        let glsl_fs = @LITDECL(2276);
        self.program = create_program_5(gl, glsl_vs, "", "", glsl_gs, glsl_fs);
        gl!(gl.link_program(self.program));
        if !check_program(gl, self.program) {
            return Ok(ERROR);
        }

        init_zero_buffers(gl, &mut self.storage_buffer, 0, 4);

        init_vertex_state(gl, &POINT_VERTICES, &mut self.vertex_buffer, &mut self.vertex_array);

        gl!(gl.clear(glw::GL_COLOR_BUFFER_BIT));
        gl!(gl.use_program(self.program));
        gl!(gl.bind_vertex_array(self.vertex_array));
        gl!(gl.draw_arrays(glw::GL_POINTS, 0, 4));
        gl!(gl.memory_barrier(glw::GL_BUFFER_UPDATE_BARRIER_BIT));

        for ii in 0..3 {
            if !gl_primitives_u(gl, &self.storage_buffer, ii, false, 4) {
                return Ok(ERROR);
            }
        }
        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.use_program(0));
        gl!(gl.delete_program(self.program));
        gl!(gl.delete_buffers(6, self.storage_buffer.as_ptr()));
        gl!(gl.delete_buffers(1, &self.vertex_buffer));
        gl!(gl.delete_vertex_arrays(1, &self.vertex_array));
        Ok(NO_ERROR)
    }
}

