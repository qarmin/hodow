/// The storage buffer of the Case3 programs: eight ivec4 holding (0, 1, 2, 0).
fn init_case3_storage_buffer(gl: &glw::Functions, storage_buffer: &mut GLuint) {
    gl!(gl.gen_buffers(1, storage_buffer));
    gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, 0, *storage_buffer));
    let values: Vec<GLint> = (0..8).flat_map(|_| [0, 1, 2, 0]).collect();
    ssbo_data(gl, &values, glw::GL_DYNAMIC_DRAW);
}

/// 1.8.3 BasicAtomicCase3 (VS, GS and FS)
#[derive(Default)]
pub(super) struct BasicAtomicCase3 {
    program: GLuint,
    storage_buffer: GLuint,
    vertex_array: GLuint,
    vertex_buffer: GLuint,
}

impl Subcase for BasicAtomicCase3 {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        if !supported_in_vs(gl, 1) {
            return Ok(NOT_SUPPORTED);
        }
        if !supported_in_gs(gl, 1) {
            return Ok(NOT_SUPPORTED);
        }

        let glsl_vs = @LITDECL(2682);
        let glsl_gs = @LITDECL(2690);
        let glsl_fs = @LITDECL(2697);
        self.program = create_program_5(gl, glsl_vs, "", "", glsl_gs, glsl_fs);
        gl!(gl.link_program(self.program));
        if !check_program(gl, self.program) {
            return Ok(ERROR);
        }

        init_case3_storage_buffer(gl, &mut self.storage_buffer);
        init_vertex_state(gl, &POINT_VERTICES, &mut self.vertex_buffer, &mut self.vertex_array);

        gl!(gl.clear(glw::GL_COLOR_BUFFER_BIT));
        gl!(gl.use_program(self.program));
        gl!(gl.bind_vertex_array(self.vertex_array));
        gl!(gl.draw_arrays(glw::GL_POINTS, 0, 4));
        gl!(gl.memory_barrier(glw::GL_BUFFER_UPDATE_BARRIER_BIT));

        let u = get_sub_data::<GLuint>(gl, 0, 1)[0];
        if u != 20 {
            log::info!("Data at offset 0 is {u} should be 20.");
            return Ok(ERROR);
        }
        let i = get_sub_data::<GLint>(gl, 4 * 4 * 4, 1)[0];
        if i != 20 {
            log::info!("Data at offset 0 is {i} should be 20.");
            return Ok(ERROR);
        }

        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.use_program(0));
        gl!(gl.delete_program(self.program));
        gl!(gl.delete_buffers(1, &self.storage_buffer));
        gl!(gl.delete_buffers(1, &self.vertex_buffer));
        gl!(gl.delete_vertex_arrays(1, &self.vertex_array));
        Ok(NO_ERROR)
    }
}

/// 1.8.3 BasicAtomicCase3CS
#[derive(Default)]
pub(super) struct BasicAtomicCase3Cs {
    program: GLuint,
    storage_buffer: GLuint,
}

impl Subcase for BasicAtomicCase3Cs {
    fn run(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        let glsl_cs = @LITDECL(2792);
        self.program = create_program_cs(gl, glsl_cs);
        gl!(gl.link_program(self.program));
        if !check_program(gl, self.program) {
            return Ok(ERROR);
        }

        init_case3_storage_buffer(gl, &mut self.storage_buffer);

        gl!(gl.use_program(self.program));
        gl!(gl.dispatch_compute(1, 1, 1));
        gl!(gl.memory_barrier(glw::GL_BUFFER_UPDATE_BARRIER_BIT));

        let Some(u) = map_read::<GLuint>(gl, 0, 1) else {
            return Ok(ERROR);
        };
        if u[0] != 16 {
            return Ok(ERROR);
        }
        unmap(gl);
        let Some(i) = map_read::<GLint>(gl, 64, 1) else {
            return Ok(ERROR);
        };
        if i[0] != 16 {
            return Ok(ERROR);
        }
        unmap(gl);

        Ok(NO_ERROR)
    }

    fn cleanup(&mut self, context: &Context) -> SubcaseResult {
        let gl = context.gl();
        gl!(gl.use_program(0));
        gl!(gl.delete_program(self.program));
        gl!(gl.delete_buffers(1, &self.storage_buffer));
        Ok(NO_ERROR)
    }
}

/// The counter buffer (binding 0) and the 16-int output buffer (binding 1) of the Case4 programs.
fn init_case4_buffers(gl: &glw::Functions, storage_buffer: &mut [GLuint; 2]) {
    gl!(gl.gen_buffers(2, storage_buffer.as_mut_ptr()));
    // counter buffer
    gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, 0, storage_buffer[0]));
    ssbo_data(gl, &[0 as GLint, 7], glw::GL_DYNAMIC_DRAW);
    // output buffer
    gl!(gl.bind_buffer_base(glw::GL_SHADER_STORAGE_BUFFER, 1, storage_buffer[1]));
    ssbo_alloc(gl, 16 * 4, glw::GL_DYNAMIC_DRAW);
}

