// Modifications: rewritten in Rust for hodow_cts. PARTIAL: the templated cases of `Textures` (BufferTest, StorageAndSubImageTest, StorageMultisampleTest; @COUNT@ registrations, in upstream's order) are ported, the non-templated ones (CreationTest, CompressedSubImageTest, CopyTest, ...) are not. Upstream's `template <T, S, N, D, I>` classes are const-generic structs over a `Scalar` (the `T` plus its reference tables and internal formats). The reference tables, the `Scalar` impls and the registration are generated by hodow_cts/scripts/gen_dsa_textures.py. Upstream's `catch (tcu::NotSupportedError &e) { throw e; } catch (...) { is_error }` is `texture_verdict`.

use std::marker::PhantomData;

use super::common_bugs_tests::Shader;
use crate::glu::{self, Context, TestCase, TestCaseGroup};
use crate::glw;
use crate::tcu::{TestError, TestOutcome, TestResult, TestStatus};

const REFERENCE_COUNT: usize = 2 * 3 * 4 * 4;

const VERTEX_SHADER: &str = "#version 450\n\nvoid main()\n{\n    switch(gl_VertexID)\n    {\n        case 0:\n            gl_Position = vec4(-1.0, 1.0, 0.0, 1.0);\n            break;\n        case 1:\n            gl_Position = vec4( 1.0, 1.0, 0.0, 1.0);\n            break;\n        case 2:\n            gl_Position = vec4(-1.0,-1.0, 0.0, 1.0);\n            break;\n        case 3:\n            gl_Position = vec4( 1.0,-1.0, 0.0, 1.0);\n            break;\n    }\n}\n";
const FRAGMENT_SHADER_HEAD: &str = "#version 450\n\nlayout(pixel_center_integer) in vec4 gl_FragCoord;\n\n";

/// The `T` of upstream's templates, with `Reference::{InternalFormat, Type, ReferenceData, Compare}`.
trait Scalar: Copy + Default + Send + Sync + 'static {
    const TYPE: glw::GLenum;
    /// Sampler/vector type prefix of the fragment shader declaration: "i", "u" or "".
    fn sampler_prefix(norm: bool) -> &'static str;
    fn reference(norm: bool) -> &'static [Self; REFERENCE_COUNT];
    fn internal_format(s: usize, norm: bool) -> glw::GLenum;
    fn same(self, other: Self) -> bool;
}

/// `Reference::Format<S, N>`
fn format_of(s: usize, norm: bool) -> glw::GLenum {
    match (s, norm) {
        (1, false) => glw::GL_RED_INTEGER,
        (2, false) => glw::GL_RG_INTEGER,
        (3, false) => glw::GL_RGB_INTEGER,
        (4, false) => glw::GL_RGBA_INTEGER,
        (1, true) => glw::GL_RED,
        (2, true) => glw::GL_RG,
        (3, true) => glw::GL_RGB,
        _ => glw::GL_RGBA,
    }
}

@SCALARS@

/// The GL names of one test; each `Clean*` of upstream is a method.
#[derive(Default)]
struct Objects {
    fbo: glw::GLuint,
    rbo: glw::GLuint,
    po: glw::GLuint,
    po_aux: glw::GLuint,
    to: glw::GLuint,
    to_ms: glw::GLuint,
    to_aux: glw::GLuint,
    fbo_ms: glw::GLuint,
    fbo_aux: glw::GLuint,
    bo: glw::GLuint,
    vao: glw::GLuint,
}

impl Objects {
    fn clean_texture(&mut self, gl: &glw::Functions) {
        // SAFETY: deletes names created by the test; zero names are skipped.
        unsafe {
            if self.to != 0 {
                gl.delete_textures(1, &self.to);
                self.to = 0;
            }
        }
    }

    fn clean_buffer_texture(&mut self, gl: &glw::Functions) {
        self.clean_texture(gl);
        // SAFETY: as above.
        unsafe {
            if self.bo != 0 {
                gl.delete_buffers(1, &self.bo);
                self.bo = 0;
            }
        }
    }

    fn clean_framebuffer(&mut self, gl: &glw::Functions) {
        // SAFETY: as above.
        unsafe {
            if self.fbo != 0 {
                gl.delete_framebuffers(1, &self.fbo);
                self.fbo = 0;
            }
            if self.rbo != 0 {
                gl.delete_renderbuffers(1, &self.rbo);
                self.rbo = 0;
            }
        }
    }

    fn clean_program(&mut self, gl: &glw::Functions) {
        // SAFETY: as above.
        unsafe {
            if self.po != 0 {
                gl.use_program(0);
                gl.delete_program(self.po);
                self.po = 0;
            }
        }
    }

    fn clean_vertex_array(&mut self, gl: &glw::Functions) {
        // SAFETY: as above.
        unsafe {
            if self.vao != 0 {
                gl.bind_vertex_array(0);
                gl.delete_vertex_arrays(1, &self.vao);
                self.vao = 0;
            }
        }
    }

    /// `CleanInputTexture`, `CleanAuxiliaryTexture`, `CleanFramebuffers` and `CleanPrograms` of the multisample test.
    fn clean_multisample_framebuffers(&mut self, gl: &glw::Functions) {
        // SAFETY: as above.
        unsafe {
            if self.fbo_ms != 0 {
                gl.delete_framebuffers(1, &self.fbo_ms);
                self.fbo_ms = 0;
            }
            if self.to_ms != 0 {
                gl.delete_textures(1, &self.to_ms);
                self.to_ms = 0;
            }
            if self.fbo_aux != 0 {
                gl.delete_framebuffers(1, &self.fbo_aux);
                self.fbo_aux = 0;
            }
            if self.to_aux != 0 {
                gl.delete_textures(1, &self.to_aux);
                self.to_aux = 0;
            }
        }
    }

    fn clean_auxiliary_texture(&mut self, gl: &glw::Functions) {
        // SAFETY: as above.
        unsafe {
            if self.to_aux != 0 {
                gl.delete_textures(1, &self.to_aux);
                self.to_aux = 0;
            }
        }
    }

    fn clean_multisample_programs(&mut self, gl: &glw::Functions) {
        // SAFETY: as above.
        unsafe {
            gl.use_program(0);
            if self.po != 0 {
                gl.delete_program(self.po);
                self.po = 0;
            }
            if self.po_aux != 0 {
                gl.delete_program(self.po_aux);
                self.po_aux = 0;
            }
        }
    }
}

fn clean_errors(gl: &glw::Functions) {
    // SAFETY: plain state queries.
    while unsafe { gl.get_error() } != glw::GL_NO_ERROR {}
}

fn check_dsa_support(context: &Context) -> Result<(), TestError> {
    let is_at_least_gl_45 = context.context_type().supports_core(4, 5);
    let is_arb_direct_state_access = context.context_info.is_extension_supported("GL_ARB_direct_state_access");
    if !is_at_least_gl_45 && !is_arb_direct_state_access {
        return Err(TestError::NotSupported("Not Supported".to_string()));
    }
    Ok(())
}

/// The verdict of `iterate` once the cleanup is done: a NotSupportedError is rethrown, any other throw is an INTERNAL_ERROR.
fn texture_verdict(result: Result<bool, TestError>) -> TestOutcome {
    match result {
        Ok(true) => Ok(TestStatus::pass("Pass")),
        Ok(false) => Ok(TestStatus::fail("Fail")),
        Err(TestError::NotSupported(reason)) => Err(TestError::NotSupported(reason)),
        Err(_) => Ok(TestStatus::new(TestResult::InternalError, "Error")),
    }
}

fn throw_zero() -> TestError {
    TestError::Fail("throw 0".to_string())
}

/// The framebuffer status check that follows every `PrepareFramebuffer*`: UNSUPPORTED is a NotSupportedError, anything else but COMPLETE is `throw 0`.
fn require_complete_framebuffer(gl: &glw::Functions) -> Result<(), TestError> {
    // SAFETY: plain state query.
    let status = unsafe { gl.check_framebuffer_status(glw::GL_FRAMEBUFFER) };
    if status == glw::GL_FRAMEBUFFER_COMPLETE {
        Ok(())
    } else if status == glw::GL_FRAMEBUFFER_UNSUPPORTED {
        Err(TestError::NotSupported("unsupported framebuffer configuration".to_string()))
    } else {
        Err(throw_zero())
    }
}

/// The viewport and clear that end every `PrepareFramebuffer*`.
fn viewport_and_clear(gl: &glw::Functions, width: glw::GLsizei, height: glw::GLsizei) -> Result<(), TestError> {
    // SAFETY: plain state calls.
    unsafe {
        gl.viewport(0, 0, width, height);
        glu::expect_no_error(gl, "glViewport call failed.")?;

        gl.clear_color(0.0, 0.0, 0.0, 0.0);
        glu::expect_no_error(gl, "glClearColor call failed.")?;

        gl.clear(glw::GL_COLOR_BUFFER_BIT);
        glu::expect_no_error(gl, "glClear call failed.")
    }
}

/// `PrepareFramebuffer` of BufferTest and StorageAndSubImageTest: a renderbuffer of `size_x` x 1.
fn prepare_renderbuffer_framebuffer(gl: &glw::Functions, objects: &mut Objects, internal_format: glw::GLenum, size_x: glw::GLsizei) -> Result<(), TestError> {
    // SAFETY: names are written to live fields and used right away.
    unsafe {
        gl.gen_framebuffers(1, &mut objects.fbo);
        glu::expect_no_error(gl, "glGenFramebuffers call failed.")?;

        gl.gen_renderbuffers(1, &mut objects.rbo);
        glu::expect_no_error(gl, "glGenRenderbuffers call failed.")?;

        gl.bind_framebuffer(glw::GL_FRAMEBUFFER, objects.fbo);
        glu::expect_no_error(gl, "glBindFramebuffer call failed.")?;

        gl.bind_renderbuffer(glw::GL_RENDERBUFFER, objects.rbo);
        glu::expect_no_error(gl, "glBindRenderbuffer call failed.")?;

        gl.renderbuffer_storage(glw::GL_RENDERBUFFER, internal_format, size_x, 1);
        glu::expect_no_error(gl, "glRenderbufferStorage call failed.")?;

        gl.framebuffer_renderbuffer(glw::GL_FRAMEBUFFER, glw::GL_COLOR_ATTACHMENT0, glw::GL_RENDERBUFFER, objects.rbo);
        glu::expect_no_error(gl, "glFramebufferRenderbuffer call failed.")?;
    }

    require_complete_framebuffer(gl)?;
    viewport_and_clear(gl, size_x, 1)
}

/// `PrepareProgram`; every failure is upstream's `throw 0` after the program is deleted.
fn prepare_program(gl: &glw::Functions, fragment_declaration: &str, fragment_tail: &str) -> Result<glw::GLuint, TestError> {
    // SAFETY: plain object creation with a current context.
    let po = unsafe { gl.create_program() };

    let linked = (|| -> Result<bool, TestError> {
        glu::expect_no_error(gl, "glCreateProgram call failed.")?;

        let vertex = Shader::new(gl, glw::GL_VERTEX_SHADER)?;
        let fragment = Shader::new(gl, glw::GL_FRAGMENT_SHADER)?;
        let vertex_parts = [VERTEX_SHADER];
        let fragment_parts = [FRAGMENT_SHADER_HEAD, fragment_declaration, fragment_tail];

        for (shader, parts) in [(&vertex, &vertex_parts[..]), (&fragment, &fragment_parts[..])] {
            // SAFETY: both objects are alive.
            unsafe { gl.attach_shader(po, shader.id) };
            glu::expect_no_error(gl, "glAttachShader call failed.")?;

            shader.source(parts)?;

            if !shader.compile()? {
                log::info!("Shader compilation has failed.\nShader source code:\n{}", parts.concat());
                return Ok(false);
            }
        }

        // SAFETY: the status is written to a live local.
        unsafe { gl.link_program(po) };
        glu::expect_no_error(gl, "glTransformFeedbackVaryings call failed.")?;

        let mut status = glw::GL_FALSE as glw::GLint;
        // SAFETY: as above.
        unsafe { gl.get_programiv(po, glw::GL_LINK_STATUS, &mut status) };
        if status != glw::GL_TRUE as glw::GLint {
            log::info!("Program linkage has failed.");
            return Ok(false);
        }

        for shader in [&vertex, &fragment] {
            // SAFETY: both objects are alive and attached.
            unsafe { gl.detach_shader(po, shader.id) };
            glu::expect_no_error(gl, "glDetachShader call failed.")?;
        }
        Ok(true)
    })();

    if matches!(linked, Ok(true)) {
        return Ok(po);
    }
    // SAFETY: deletes the program created above.
    unsafe { gl.delete_program(po) };
    Err(throw_zero())
}

fn prepare_vertex_array(gl: &glw::Functions, objects: &mut Objects) -> Result<(), TestError> {
    // SAFETY: the name is written to a live field and bound.
    unsafe {
        gl.gen_vertex_arrays(1, &mut objects.vao);
        glu::expect_no_error(gl, "glGenVertexArrays has failed")?;

        gl.bind_vertex_array(objects.vao);
        glu::expect_no_error(gl, "glBindVertexArray has failed")
    }
}

/// `Draw` of BufferTest and StorageAndSubImageTest.
fn draw_with_texture_unit(gl: &glw::Functions, objects: &Objects) -> Result<(), TestError> {
    // SAFETY: plain calls on live names.
    unsafe {
        gl.use_program(objects.po);
        glu::expect_no_error(gl, "glUseProgram has failed")?;

        gl.active_texture(glw::GL_TEXTURE0);
        glu::expect_no_error(gl, "glActiveTexture has failed")?;

        gl.bind_texture_unit(0, objects.to);
        glu::expect_no_error(gl, "glActiveTexture has failed")?;

        gl.draw_arrays(glw::GL_TRIANGLE_STRIP, 0, 4);
        glu::expect_no_error(gl, "glDrawArrays has failed")
    }
}

fn set_pixel_store_alignment<T>(gl: &glw::Functions) -> Result<(), TestError> {
    let alignment = std::mem::size_of::<T>() as glw::GLint;
    // SAFETY: plain state calls.
    unsafe {
        gl.pixel_storei(glw::GL_UNPACK_ALIGNMENT, alignment);
        glu::expect_no_error(gl, "glPixelStorei has failed")?;

        gl.pixel_storei(glw::GL_PACK_ALIGNMENT, alignment);
        glu::expect_no_error(gl, "glPixelStorei has failed")
    }
}

fn matches_reference<T: Scalar>(result: &[T], norm: bool) -> bool {
    let reference = T::reference(norm);
    result.iter().zip(reference.iter()).all(|(a, b)| a.same(*b))
}

// ------------------------------------------------------------------------------------------------------------------
// BufferTest

/// `Textures::BufferTest<T, S, N>`
struct BufferTest<T: Scalar, const S: usize, const N: bool> {
    name: &'static str,
    marker: PhantomData<T>,
}

impl<T: Scalar, const S: usize, const N: bool> BufferTest<T, S, N> {
    const FBO_SIZE_X: glw::GLsizei = 6;

    fn new(name: &'static str) -> Self {
        Self { name, marker: PhantomData }
    }

    fn test_reference_data_count() -> usize {
        Self::FBO_SIZE_X as usize * S
    }

    fn test_reference_data_size() -> usize {
        Self::test_reference_data_count() * std::mem::size_of::<T>()
    }

    fn fragment_shader_declaration() -> String {
        let prefix = T::sampler_prefix(N);
        format!("uniform {prefix}samplerBuffer texture_input;\nout     {prefix}vec4          texture_output;\n")
    }

    const FRAGMENT_SHADER_TAIL: &'static str = "\nvoid main()\n{\n    texture_output = texelFetch(texture_input, int(gl_FragCoord.x));\n}\n";

    /// `CreateBufferTexture`
    fn create_buffer_texture(gl: &glw::Functions, objects: &mut Objects, use_range_version: bool) -> Result<bool, TestError> {
        let data_size = Self::test_reference_data_size() as glw::GLsizeiptr;
        let reference = T::reference(N);

        // SAFETY: names are written to live fields; the reference table holds at least `data_size` bytes.
        unsafe {
            gl.gen_textures(1, &mut objects.to);
            glu::expect_no_error(gl, "glGenTextures has failed")?;

            gl.bind_texture(glw::GL_TEXTURE_BUFFER, objects.to);
            glu::expect_no_error(gl, "glBindTexture has failed")?;

            gl.gen_buffers(1, &mut objects.bo);
            glu::expect_no_error(gl, "glCreateBuffers has failed")?;

            gl.bind_buffer(glw::GL_TEXTURE_BUFFER, objects.bo);
            glu::expect_no_error(gl, "glBindBuffer has failed")?;

            if use_range_version {
                let mut alignment: glw::GLint = 1;
                gl.get_integerv(glw::GL_TEXTURE_BUFFER_OFFSET_ALIGNMENT, &mut alignment);
                glu::expect_no_error(gl, "glGetIntegerv has failed")?;

                let b_offset = alignment as glw::GLintptr;
                let b_size = data_size + b_offset;

                gl.buffer_data(glw::GL_TEXTURE_BUFFER, b_size, std::ptr::null(), glw::GL_STATIC_DRAW);
                glu::expect_no_error(gl, "glBufferData has failed")?;

                gl.buffer_sub_data(glw::GL_TEXTURE_BUFFER, b_offset, data_size, reference.as_ptr().cast());
                glu::expect_no_error(gl, "glBufferSubdata has failed")?;

                gl.texture_buffer_range(objects.to, T::internal_format(S, N), objects.bo, b_offset, data_size);
            } else {
                gl.buffer_data(glw::GL_TEXTURE_BUFFER, data_size, reference.as_ptr().cast(), glw::GL_STATIC_DRAW);
                glu::expect_no_error(gl, "glNamedBufferData has failed")?;

                gl.texture_buffer(objects.to, T::internal_format(S, N), objects.bo);
            }

            let error = gl.get_error();
            if error != glw::GL_NO_ERROR {
                log::info!(
                    "{} unexpectedly generated error {} during test of internal format {:#x}.",
                    if use_range_version { "glTextureBufferRange" } else { "glTextureBuffer" },
                    glw::error_name(error),
                    T::internal_format(S, N)
                );
                objects.clean_buffer_texture(gl);
                return Ok(false);
            }
        }

        Ok(true)
    }

    /// `Check`
    fn check(gl: &glw::Functions) -> Result<bool, TestError> {
        let mut result = vec![T::default(); Self::test_reference_data_count()];

        set_pixel_store_alignment::<T>(gl)?;

        // SAFETY: `result` holds `test_reference_data_size()` bytes.
        unsafe {
            gl.readn_pixels(0, 0, Self::FBO_SIZE_X, 1, format_of(S, N), T::TYPE, Self::test_reference_data_size() as glw::GLsizei, result.as_mut_ptr().cast());
        }
        glu::expect_no_error(gl, "glReadPixels has failed")?;

        Ok(matches_reference::<T>(&result, N))
    }

    /// `Test`
    fn test(gl: &glw::Functions, objects: &mut Objects, use_range_version: bool) -> Result<bool, TestError> {
        prepare_renderbuffer_framebuffer(gl, objects, T::internal_format(S, N), Self::FBO_SIZE_X)?;

        if !Self::create_buffer_texture(gl, objects, use_range_version)? {
            objects.clean_framebuffer(gl);
            clean_errors(gl);
            return Ok(false);
        }

        draw_with_texture_unit(gl, objects)?;

        let result = Self::check(gl)?;

        objects.clean_framebuffer(gl);
        objects.clean_buffer_texture(gl);
        clean_errors(gl);

        Ok(result)
    }
}

impl<T: Scalar, const S: usize, const N: bool> TestCase for BufferTest<T, S, N> {
    fn name(&self) -> &str {
        self.name
    }

    fn check_support(&self, context: &Context) -> Result<(), TestError> {
        check_dsa_support(context)
    }

    fn iterate(&self, context: &Context) -> TestOutcome {
        let gl = context.gl();
        let mut objects = Objects::default();

        let result = (|| -> Result<bool, TestError> {
            let mut is_ok = true;

            prepare_vertex_array(gl, &mut objects)?;
            objects.po = prepare_program(gl, &Self::fragment_shader_declaration(), Self::FRAGMENT_SHADER_TAIL)?;

            for i in 0..2 {
                let use_range = i == 1;
                is_ok &= Self::test(gl, &mut objects, use_range)?;
                clean_errors(gl);
            }

            objects.clean_program(gl);
            Ok(is_ok)
        })();

        objects.clean_buffer_texture(gl);
        objects.clean_framebuffer(gl);
        objects.clean_program(gl);
        clean_errors(gl);
        objects.clean_vertex_array(gl);
        clean_errors(gl);

        texture_verdict(result)
    }
}

// ------------------------------------------------------------------------------------------------------------------
// StorageAndSubImageTest

/// `Textures::StorageAndSubImageTest<T, S, N, D, I>`: `I` selects the SubImage test (storage through the legacy call) over the Storage test (sub image through the legacy call).
struct StorageAndSubImageTest<T: Scalar, const S: usize, const N: bool, const D: usize, const I: bool> {
    name: &'static str,
    marker: PhantomData<T>,
}

impl<T: Scalar, const S: usize, const N: bool, const D: usize, const I: bool> StorageAndSubImageTest<T, S, N, D, I> {
    fn new(name: &'static str) -> Self {
        Self { name, marker: PhantomData }
    }

    fn width() -> glw::GLsizei {
        2
    }

    fn height() -> glw::GLsizei {
        if D >= 2 { 3 } else { 1 }
    }

    fn depth() -> glw::GLsizei {
        if D == 3 { 4 } else { 1 }
    }

    fn test_reference_data_count() -> usize {
        2 * if D > 1 { 3 } else { 1 } * if D > 2 { 4 } else { 1 } * S
    }

    fn test_reference_data_size() -> usize {
        Self::test_reference_data_count() * std::mem::size_of::<T>()
    }

    fn fbo_size_x() -> glw::GLsizei {
        match D {
            1 => 2,
            2 => 2 * 3,
            _ => 2 * 3 * 4,
        }
    }

    fn fragment_shader_declaration() -> String {
        let prefix = T::sampler_prefix(N);
        format!("uniform {prefix}sampler{D}D texture_input;\nout     {prefix}vec4         texture_output;\n")
    }

    fn fragment_shader_tail() -> &'static str {
        match D {
            1 => "\nvoid main()\n{\n    texture_output = texelFetch(texture_input, int(gl_FragCoord.x), 0);\n}\n",
            2 => "\nvoid main()\n{\n    texture_output = texelFetch(texture_input, ivec2(int(gl_FragCoord.x) % 2, int(floor(gl_FragCoord.x / 2))), 0);\n}\n",
            _ => "\nvoid main()\n{\n    texture_output = texelFetch(texture_input, ivec3(int(gl_FragCoord.x) % 2, int(floor(gl_FragCoord.x / 2)) % 3, int(floor(gl_FragCoord.x / 2 / 3))), 0);\n}\n",
        }
    }

    fn texture_target() -> glw::GLenum {
        match D {
            1 => glw::GL_TEXTURE_1D,
            2 => glw::GL_TEXTURE_2D,
            _ => glw::GL_TEXTURE_3D,
        }
    }

    /// `TextureStorage`
    fn texture_storage(gl: &glw::Functions, objects: &mut Objects, target: glw::GLenum, levels: glw::GLsizei, internalformat: glw::GLenum) -> Result<bool, TestError> {
        let (width, height, depth) = (Self::width(), Self::height(), Self::depth());
        let texture = objects.to;

        // SAFETY: plain calls on the live texture.
        unsafe {
            if I {
                match D {
                    1 => gl.tex_storage_1d(target, levels, internalformat, width),
                    2 => gl.tex_storage_2d(target, levels, internalformat, width, height),
                    _ => gl.tex_storage_3d(target, levels, internalformat, width, height, depth),
                }
                glu::expect_no_error(gl, "glTexStorage*() has failed")?;
                Ok(true)
            } else {
                match D {
                    1 => gl.texture_storage_1d(texture, levels, internalformat, width),
                    2 => gl.texture_storage_2d(texture, levels, internalformat, width, height),
                    _ => gl.texture_storage_3d(texture, levels, internalformat, width, height, depth),
                }

                let error = gl.get_error();
                if error != glw::GL_NO_ERROR {
                    log::info!(
                        "glTextureStorage{D}D unexpectedly generated error {} during test with levels {levels}, internal format {internalformat:#x} width={width} height={height} depth={depth}.",
                        glw::error_name(error)
                    );
                    objects.clean_texture(gl);
                    clean_errors(gl);
                    return Ok(false);
                }
                Ok(true)
            }
        }
    }

    /// `TextureSubImage`
    fn texture_sub_image(gl: &glw::Functions, objects: &mut Objects, target: glw::GLenum, level: glw::GLint, format: glw::GLenum, type_: glw::GLenum, data: *const std::ffi::c_void) -> Result<bool, TestError> {
        let (width, height, depth) = (Self::width(), Self::height(), Self::depth());
        let texture = objects.to;

        // SAFETY: `data` points at the reference table, which holds the whole texture.
        unsafe {
            if I {
                match D {
                    1 => gl.texture_sub_image_1d(texture, level, 0, width, format, type_, data),
                    2 => gl.texture_sub_image_2d(texture, level, 0, 0, width, height, format, type_, data),
                    _ => gl.texture_sub_image_3d(texture, level, 0, 0, 0, width, height, depth, format, type_, data),
                }

                let error = gl.get_error();
                if error != glw::GL_NO_ERROR {
                    log::info!(
                        "glTextureSubImage{D}D unexpectedly generated error {} during test with level {level}, width={width}, height={height}, depth={depth} format {format:#x} and type {type_:#x}.",
                        glw::error_name(error)
                    );
                    objects.clean_texture(gl);
                    clean_errors(gl);
                    return Ok(false);
                }
                Ok(true)
            } else {
                match D {
                    1 => gl.tex_sub_image_1d(target, level, 0, width, format, type_, data),
                    2 => gl.tex_sub_image_2d(target, level, 0, 0, width, height, format, type_, data),
                    _ => gl.tex_sub_image_3d(target, level, 0, 0, 0, width, height, depth, format, type_, data),
                }
                glu::expect_no_error(gl, "glTexSubImage*() has failed")?;
                Ok(true)
            }
        }
    }

    /// `CreateTexture`
    fn create_texture(gl: &glw::Functions, objects: &mut Objects) -> Result<bool, TestError> {
        let target = Self::texture_target();

        // SAFETY: the name is written to a live field and bound.
        unsafe {
            gl.gen_textures(1, &mut objects.to);
            glu::expect_no_error(gl, "glGenTextures has failed")?;

            gl.bind_texture(target, objects.to);
            glu::expect_no_error(gl, "glBindTexture has failed")?;
        }

        if Self::texture_storage(gl, objects, target, 1, T::internal_format(S, N))?
            && Self::texture_sub_image(gl, objects, target, 0, format_of(S, N), T::TYPE, T::reference(N).as_ptr().cast())?
        {
            // SAFETY: plain state calls on the bound texture.
            unsafe {
                gl.tex_parameteri(target, glw::GL_TEXTURE_MIN_FILTER, glw::GL_NEAREST as glw::GLint);
                gl.tex_parameteri(target, glw::GL_TEXTURE_MAG_FILTER, glw::GL_NEAREST as glw::GLint);
            }
            return Ok(true);
        }

        objects.clean_texture(gl);
        Ok(false)
    }

    /// `Check`
    fn check(gl: &glw::Functions) -> Result<bool, TestError> {
        let mut result = vec![T::default(); Self::test_reference_data_count()];

        // SAFETY: `result` holds `test_reference_data_size()` bytes.
        unsafe {
            gl.readn_pixels(0, 0, Self::fbo_size_x(), 1, format_of(S, N), T::TYPE, Self::test_reference_data_size() as glw::GLsizei, result.as_mut_ptr().cast());
        }
        glu::expect_no_error(gl, "glReadPixels has failed")?;

        Ok(matches_reference::<T>(&result, N))
    }

    /// `Test`
    fn test(gl: &glw::Functions, objects: &mut Objects) -> Result<bool, TestError> {
        set_pixel_store_alignment::<T>(gl)?;

        prepare_renderbuffer_framebuffer(gl, objects, T::internal_format(S, N), Self::fbo_size_x())?;

        if !Self::create_texture(gl, objects)? {
            return Ok(false);
        }

        draw_with_texture_unit(gl, objects)?;

        let result = Self::check(gl)?;

        objects.clean_texture(gl);
        objects.clean_framebuffer(gl);
        clean_errors(gl);

        Ok(result)
    }
}

impl<T: Scalar, const S: usize, const N: bool, const D: usize, const I: bool> TestCase for StorageAndSubImageTest<T, S, N, D, I> {
    fn name(&self) -> &str {
        self.name
    }

    fn check_support(&self, context: &Context) -> Result<(), TestError> {
        check_dsa_support(context)
    }

    fn iterate(&self, context: &Context) -> TestOutcome {
        let gl = context.gl();
        let mut objects = Objects::default();

        let result = (|| -> Result<bool, TestError> {
            prepare_vertex_array(gl, &mut objects)?;
            objects.po = prepare_program(gl, &Self::fragment_shader_declaration(), Self::fragment_shader_tail())?;
            Self::test(gl, &mut objects)
        })();

        objects.clean_texture(gl);
        objects.clean_framebuffer(gl);
        objects.clean_program(gl);
        clean_errors(gl);
        objects.clean_vertex_array(gl);
        clean_errors(gl);

        texture_verdict(result)
    }
}

// ------------------------------------------------------------------------------------------------------------------
// StorageMultisampleTest

/// `Textures::StorageMultisampleTest<T, S, N, D>`: D is 2 (GL_TEXTURE_2D_MULTISAMPLE) or 3 (GL_TEXTURE_2D_MULTISAMPLE_ARRAY).
struct StorageMultisampleTest<T: Scalar, const S: usize, const N: bool, const D: usize> {
    name: &'static str,
    marker: PhantomData<T>,
}

impl<T: Scalar, const S: usize, const N: bool, const D: usize> StorageMultisampleTest<T, S, N, D> {
    fn new(name: &'static str) -> Self {
        Self { name, marker: PhantomData }
    }

    fn width() -> glw::GLsizei {
        2
    }

    fn height() -> glw::GLsizei {
        3
    }

    fn depth() -> glw::GLsizei {
        if D == 3 { 4 } else { 1 }
    }

    fn test_reference_data_count() -> usize {
        2 * 3 * if D > 2 { 4 } else { 1 } * S
    }

    /// `FragmentShaderDeclarationMultisample`: the program that draws the input texture into the multisample one.
    fn fragment_shader_declaration_multisample() -> String {
        let prefix = T::sampler_prefix(N);
        let sampler = if D == 2 { "sampler2D" } else { "sampler2DArray" };
        format!("uniform {prefix}{sampler} texture_input;\nout     {prefix}vec4         texture_output;\n")
    }

    /// `FragmentShaderDeclarationAuxiliary`: the program that draws the multisample texture into the auxiliary one.
    fn fragment_shader_declaration_auxiliary() -> String {
        let prefix = T::sampler_prefix(N);
        let sampler = if D == 2 { "sampler2DMS" } else { "sampler2DMSArray" };
        format!("uniform {prefix}{sampler} texture_input;\nout     {prefix}vec4         texture_output;\n")
    }

    fn fragment_shader_tail() -> &'static str {
        if D == 2 {
            "\nvoid main()\n{\n    texture_output = texelFetch(texture_input, ivec2(gl_FragCoord.xy), 0);\n}\n"
        } else {
            "\nuniform int texture_layer;\n\nvoid main()\n{\n    texture_output = texelFetch(texture_input, ivec3(gl_FragCoord.xy, texture_layer), 0);\n}\n"
        }
    }

    fn multisample_texture_target() -> glw::GLenum {
        if D == 2 { glw::GL_TEXTURE_2D_MULTISAMPLE } else { glw::GL_TEXTURE_2D_MULTISAMPLE_ARRAY }
    }

    fn input_texture_target() -> glw::GLenum {
        if D == 2 { glw::GL_TEXTURE_2D } else { glw::GL_TEXTURE_2D_ARRAY }
    }

    /// `CreateInputTexture` with `InputTextureImage`
    fn create_input_texture(gl: &glw::Functions, objects: &mut Objects) -> Result<(), TestError> {
        let target = Self::input_texture_target();
        let reference = T::reference(N);

        // SAFETY: the name is written to a live field; the reference table holds the whole texture.
        unsafe {
            gl.gen_textures(1, &mut objects.to);
            glu::expect_no_error(gl, "glGenTextures has failed")?;

            gl.bind_texture(target, objects.to);
            glu::expect_no_error(gl, "glBindTexture has failed")?;

            let internal_format = T::internal_format(S, N) as glw::GLint;
            if D == 2 {
                gl.tex_image_2d(target, 0, internal_format, Self::width(), Self::height(), 0, format_of(S, N), T::TYPE, reference.as_ptr().cast());
            } else {
                gl.tex_image_3d(target, 0, internal_format, Self::width(), Self::height(), Self::depth(), 0, format_of(S, N), T::TYPE, reference.as_ptr().cast());
            }
            glu::expect_no_error(gl, "glTexImage has failed")?;

            gl.tex_parameteri(target, glw::GL_TEXTURE_MAG_FILTER, glw::GL_NEAREST as glw::GLint);
            gl.tex_parameteri(target, glw::GL_TEXTURE_MIN_FILTER, glw::GL_NEAREST as glw::GLint);
            glu::expect_no_error(gl, "glTexParameteri call failed.")
        }
    }

    /// The attachment loop of both `PrepareFramebuffer*` functions.
    fn attach_texture(gl: &glw::Functions, texture: glw::GLuint, target_2d: glw::GLenum) -> Result<(), TestError> {
        // SAFETY: plain calls on the live texture and the bound framebuffer.
        unsafe {
            if D == 2 {
                gl.framebuffer_texture_2d(glw::GL_FRAMEBUFFER, glw::GL_COLOR_ATTACHMENT0, target_2d, texture, 0);
            } else {
                for i in 0..Self::depth() {
                    gl.framebuffer_texture_layer(glw::GL_FRAMEBUFFER, glw::GL_COLOR_ATTACHMENT0 + i as u32, texture, 0, i);
                    glu::expect_no_error(gl, "glFramebufferTextureLayer call failed.")?;
                }
            }
            glu::expect_no_error(gl, "glFramebufferRenderbuffer call failed.")
        }
    }

    /// `PrepareFramebufferMultisample`
    fn prepare_framebuffer_multisample(gl: &glw::Functions, objects: &mut Objects, internal_format: glw::GLenum) -> Result<bool, TestError> {
        // SAFETY: names are written to live fields and used right away.
        unsafe {
            gl.gen_framebuffers(1, &mut objects.fbo_ms);
            glu::expect_no_error(gl, "glGenFramebuffers call failed.")?;

            gl.gen_textures(1, &mut objects.to_ms);
            glu::expect_no_error(gl, "glGenRenderbuffers call failed.")?;

            gl.bind_framebuffer(glw::GL_FRAMEBUFFER, objects.fbo_ms);
            glu::expect_no_error(gl, "glBindFramebuffer call failed.")?;

            gl.bind_texture(Self::multisample_texture_target(), objects.to_ms);
            glu::expect_no_error(gl, "glBindRenderbuffer call failed.")?;

            if D == 2 {
                gl.texture_storage_2d_multisample(objects.to_ms, 1, internal_format, Self::width(), Self::height(), glw::FALSE);
            } else {
                gl.texture_storage_3d_multisample(objects.to_ms, 1, internal_format, Self::width(), Self::height(), Self::depth(), glw::FALSE);
            }

            let error = gl.get_error();
            if error != glw::GL_NO_ERROR {
                objects.clean_multisample_framebuffers(gl);
                log::info!(
                    "glTextureStorageMultisample unexpectedly generated error {} during the test of internal format {internal_format:#x}. Test fails.",
                    glw::error_name(error)
                );
                return Ok(false);
            }
        }

        Self::attach_texture(gl, objects.to_ms, glw::GL_TEXTURE_2D_MULTISAMPLE)?;
        require_complete_framebuffer(gl)?;
        viewport_and_clear(gl, Self::width(), Self::height())?;
        Ok(true)
    }

    /// `PrepareFramebufferAuxiliary`
    fn prepare_framebuffer_auxiliary(gl: &glw::Functions, objects: &mut Objects, internal_format: glw::GLenum) -> Result<(), TestError> {
        // SAFETY: names are written to live fields and used right away.
        unsafe {
            gl.gen_framebuffers(1, &mut objects.fbo_aux);
            glu::expect_no_error(gl, "glGenFramebuffers call failed.")?;

            gl.gen_textures(1, &mut objects.to_aux);
            glu::expect_no_error(gl, "glGenRenderbuffers call failed.")?;

            gl.bind_framebuffer(glw::GL_FRAMEBUFFER, objects.fbo_aux);
            glu::expect_no_error(gl, "glBindFramebuffer call failed.")?;

            gl.bind_texture(Self::input_texture_target(), objects.to_aux);
            glu::expect_no_error(gl, "glBindRenderbuffer call failed.")?;

            if D == 2 {
                gl.texture_storage_2d(objects.to_aux, 1, internal_format, Self::width(), Self::height());
            } else {
                gl.texture_storage_3d(objects.to_aux, 1, internal_format, Self::width(), Self::height(), Self::depth());
            }
            glu::expect_no_error(gl, "glTextureStorage2D call failed.")?;

            gl.tex_parameteri(glw::GL_TEXTURE_2D, glw::GL_TEXTURE_MAG_FILTER, glw::GL_NEAREST as glw::GLint);
            gl.tex_parameteri(glw::GL_TEXTURE_2D, glw::GL_TEXTURE_MIN_FILTER, glw::GL_NEAREST as glw::GLint);
            glu::expect_no_error(gl, "glTexParameteri call failed.")?;
        }

        Self::attach_texture(gl, objects.to_aux, glw::GL_TEXTURE_2D)?;
        require_complete_framebuffer(gl)?;
        viewport_and_clear(gl, Self::width(), Self::height())
    }

    /// One of the two passes of `Draw`: `framebuffer`, `program` and the texture bound to unit 0 are the only differences; the layer uniform is set through `layer_program` (upstream names the auxiliary program in both passes).
    fn draw_layers(gl: &glw::Functions, layer_program: glw::GLuint) -> Result<(), TestError> {
        for i in 0..Self::depth() {
            // SAFETY: plain calls on live names; the uniform name is NUL-terminated.
            unsafe {
                gl.draw_buffer(glw::GL_COLOR_ATTACHMENT0 + i as u32);
                glu::expect_no_error(gl, "glDrawBuffer has failed")?;

                if D == 3 {
                    gl.uniform_1i(gl.get_uniform_location(layer_program, c"texture_layer".as_ptr()), i);
                    glu::expect_no_error(gl, "glUniform1i or glGetUniformLocation has failed")?;
                }

                gl.draw_arrays(glw::GL_TRIANGLE_STRIP, 0, 4);
                glu::expect_no_error(gl, "glDrawArrays has failed")?;
            }
        }
        Ok(())
    }

    /// `Draw`
    fn draw(gl: &glw::Functions, objects: &Objects) -> Result<(), TestError> {
        // SAFETY: plain calls on live names; the uniform name is NUL-terminated.
        unsafe {
            gl.bind_framebuffer(glw::GL_FRAMEBUFFER, objects.fbo_ms);
            glu::expect_no_error(gl, "glBindFramebuffer has failed")?;

            gl.use_program(objects.po);
            glu::expect_no_error(gl, "glUseProgram has failed")?;

            gl.active_texture(glw::GL_TEXTURE0);
            glu::expect_no_error(gl, "glActiveTexture has failed")?;

            gl.bind_texture(Self::input_texture_target(), objects.to);
            glu::expect_no_error(gl, "glActiveTexture has failed")?;

            gl.uniform_1i(gl.get_uniform_location(objects.po, c"texture_input".as_ptr()), 0);
            glu::expect_no_error(gl, "glUniform1i or glGetUniformLocation has failed")?;
        }

        Self::draw_layers(gl, objects.po_aux)?;

        // SAFETY: as above.
        unsafe {
            gl.bind_framebuffer(glw::GL_FRAMEBUFFER, objects.fbo_aux);
            glu::expect_no_error(gl, "glBindFramebuffer has failed")?;

            gl.use_program(objects.po_aux);
            glu::expect_no_error(gl, "glUseProgram has failed")?;

            gl.active_texture(glw::GL_TEXTURE0);
            glu::expect_no_error(gl, "glActiveTexture has failed")?;

            gl.bind_texture(Self::multisample_texture_target(), objects.to_ms);
            glu::expect_no_error(gl, "glActiveTexture has failed")?;

            gl.bind_texture_unit(0, objects.to);

            gl.uniform_1i(gl.get_uniform_location(objects.po_aux, c"texture_input".as_ptr()), 0);
            glu::expect_no_error(gl, "glUniform1i or glGetUniformLocation has failed")?;
        }

        Self::draw_layers(gl, objects.po_aux)
    }

    /// `Check`
    fn check(gl: &glw::Functions, objects: &Objects) -> Result<bool, TestError> {
        let mut result = vec![T::default(); Self::test_reference_data_count()];

        // SAFETY: `result` holds the whole auxiliary texture.
        unsafe {
            gl.bind_texture(Self::input_texture_target(), objects.to_aux);
            glu::expect_no_error(gl, "glBindTexture has failed")?;

            gl.get_tex_image(Self::input_texture_target(), 0, format_of(S, N), T::TYPE, result.as_mut_ptr().cast());
            glu::expect_no_error(gl, "glGetTexImage has failed")?;
        }

        Ok(matches_reference::<T>(&result, N))
    }

    /// `Test`
    fn test(gl: &glw::Functions, objects: &mut Objects) -> Result<bool, TestError> {
        set_pixel_store_alignment::<T>(gl)?;

        Self::create_input_texture(gl, objects)?;

        if !Self::prepare_framebuffer_multisample(gl, objects, T::internal_format(S, N))? {
            objects.clean_texture(gl);
            return Ok(false);
        }

        Self::prepare_framebuffer_auxiliary(gl, objects, T::internal_format(S, N))?;

        Self::draw(gl, objects)?;

        let result = Self::check(gl, objects)?;

        objects.clean_auxiliary_texture(gl);
        objects.clean_multisample_framebuffers(gl);
        objects.clean_texture(gl);
        clean_errors(gl);

        Ok(result)
    }
}

impl<T: Scalar, const S: usize, const N: bool, const D: usize> TestCase for StorageMultisampleTest<T, S, N, D> {
    fn name(&self) -> &str {
        self.name
    }

    fn check_support(&self, context: &Context) -> Result<(), TestError> {
        check_dsa_support(context)
    }

    fn iterate(&self, context: &Context) -> TestOutcome {
        let gl = context.gl();
        let mut objects = Objects::default();

        let result = (|| -> Result<bool, TestError> {
            prepare_vertex_array(gl, &mut objects)?;
            objects.po = prepare_program(gl, &Self::fragment_shader_declaration_multisample(), Self::fragment_shader_tail())?;
            objects.po_aux = prepare_program(gl, &Self::fragment_shader_declaration_auxiliary(), Self::fragment_shader_tail())?;
            Self::test(gl, &mut objects)
        })();

        objects.clean_texture(gl);
        objects.clean_auxiliary_texture(gl);
        objects.clean_multisample_framebuffers(gl);
        objects.clean_multisample_programs(gl);
        clean_errors(gl);
        objects.clean_vertex_array(gl);
        // SAFETY: plain state call.
        unsafe { gl.disable(glw::GL_MULTISAMPLE) };
        clean_errors(gl);

        texture_verdict(result)
    }
}

/// The templated `Textures` cases, in the order of `Tests::init`.
pub fn add_tests(group: &mut TestCaseGroup) {
@REGISTRATIONS@}
