	result *= compare_u8vec3(uvec3(v), uvec3(0u, 0u, 0u));
	result *= compare_uint((blockI[0].w), 0u);
	result *= compare_ivec2((blockI[0].x), ivec2(0, 0));
	result *= compare_i8vec3(ivec3(blockI[0].y), ivec3(0, 0, 0));
	result *= compare_bool((blockI[0].z), false);
	result *= compare_uint((blockI[1].w), 0u);
