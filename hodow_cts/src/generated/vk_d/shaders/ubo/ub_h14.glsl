    mediump float result = 1.0;
	result *= compare_uint((l), 0u);
	result *= compare_i8vec3(ivec3(blockH.m), ivec3(0, 0, 0));
	result *= compare_uvec3((blockH.n[0]), uvec3(0u, 0u, 0u));
	result *= compare_uvec3((blockH.n[1]), uvec3(0u, 0u, 0u));
	result *= compare_uvec3((blockH.n[2]), uvec3(0u, 0u, 0u));
