#extension GL_EXT_nonuniform_qualifier : enable
layout(location = 0) in mediump float v_vtxResult;
layout(location = 0) out mediump vec4 dEQP_FragColor;

layout(set = 0, binding = 0, scalar) uniform Block
{
	uint8_t padding;
	uint8_t var[3][4];
};

mediump float compare_uint8_t  (highp uint a, highp uint b)    { return a == b ? 1.0 : 0.0; }

void main (void)
{
    mediump float result = 1.0;
	result *= compare_uint8_t(uint(var[0][0]), 0u);
	result *= compare_uint8_t(uint(var[0][1]), 0u);
	result *= compare_uint8_t(uint(var[0][2]), 0u);
	result *= compare_uint8_t(uint(var[0][3]), 0u);
	result *= compare_uint8_t(uint(var[1][0]), 0u);
	result *= compare_uint8_t(uint(var[1][1]), 0u);
	result *= compare_uint8_t(uint(var[1][2]), 0u);
	result *= compare_uint8_t(uint(var[1][3]), 0u);
	result *= compare_uint8_t(uint(var[2][0]), 0u);
	result *= compare_uint8_t(uint(var[2][1]), 0u);
	result *= compare_uint8_t(uint(var[2][2]), 0u);
	result *= compare_uint8_t(uint(var[2][3]), 0u);
    dEQP_FragColor = vec4(1.0, v_vtxResult, result, 1.0);
}
