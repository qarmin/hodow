	result *= compare_u8vec2(uvec2(j), uvec2(0u, 0u));
	result *= compare_vec3((k), vec3(0.0, 0.0, 0.0));
	result *= compare_uvec4((l), uvec4(0u, 0u, 0u, 0u));
	result *= compare_i8vec2(ivec2(m), ivec2(0, 0));
