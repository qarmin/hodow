	result *= compare_f16vec4(vec4(var[17]), vec4(0.0, 0.0, 0.0, 0.0));
	result *= compare_f16vec4(vec4(var[18]), vec4(0.0, 0.0, 0.0, 0.0));
    dEQP_FragColor = vec4(1.0, v_vtxResult, result, 1.0);
