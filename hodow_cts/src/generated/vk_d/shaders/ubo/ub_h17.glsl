{
    mediump float result = 1.0;
	result *= compare_f16vec4(vec4(var[0]), vec4(0.0, 0.0, 0.0, 0.0));
	result *= compare_f16vec4(vec4(var[1]), vec4(0.0, 0.0, 0.0, 0.0));
