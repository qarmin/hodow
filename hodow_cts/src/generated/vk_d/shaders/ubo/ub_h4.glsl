	result *= compare_bvec4((var[1][0]), bvec4(false, false, false, false));
	result *= compare_bvec4((var[1][1]), bvec4(false, false, false, false));
	result *= compare_bvec4((var[1][2]), bvec4(false, false, false, false));
	result *= compare_bvec4((var[1][3]), bvec4(false, false, false, false));
	result *= compare_bvec4((var[2][0]), bvec4(false, false, false, false));
	result *= compare_bvec4((var[2][1]), bvec4(false, false, false, false));
	result *= compare_bvec4((var[2][2]), bvec4(false, false, false, false));
	result *= compare_bvec4((var[2][3]), bvec4(false, false, false, false));
    dEQP_FragColor = vec4(1.0, v_vtxResult, result, 1.0);
