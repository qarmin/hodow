	result *= compare_vec4((s[2].c), vec4(0.0, 0.0, 0.0, 0.0));
	result *= compare_vec4((v), vec4(0.0, 0.0, 0.0, 0.0));
    imageStore(outImage, coord, vec4(result));
}
