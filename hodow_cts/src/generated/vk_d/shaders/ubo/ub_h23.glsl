void main (void)
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    mediump float result = 1.0;
	result *= compare_vec3((var[0][0]), vec3(0.0, 0.0, 0.0));
	result *= compare_vec3((var[0][1]), vec3(0.0, 0.0, 0.0));
	result *= compare_vec3((var[0][2]), vec3(0.0, 0.0, 0.0));
	result *= compare_vec3((var[0][3]), vec3(0.0, 0.0, 0.0));
	result *= compare_vec3((var[1][0]), vec3(0.0, 0.0, 0.0));
	result *= compare_vec3((var[1][1]), vec3(0.0, 0.0, 0.0));
	result *= compare_vec3((var[1][2]), vec3(0.0, 0.0, 0.0));
	result *= compare_vec3((var[1][3]), vec3(0.0, 0.0, 0.0));
	result *= compare_vec3((var[2][0]), vec3(0.0, 0.0, 0.0));
	result *= compare_vec3((var[2][1]), vec3(0.0, 0.0, 0.0));
	result *= compare_vec3((var[2][2]), vec3(0.0, 0.0, 0.0));
	result *= compare_vec3((var[2][3]), vec3(0.0, 0.0, 0.0));
    imageStore(outImage, coord, vec4(result));
}
