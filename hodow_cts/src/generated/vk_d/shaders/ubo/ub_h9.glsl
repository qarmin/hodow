#extension GL_EXT_nonuniform_qualifier : enable
layout(location = 0) in mediump float v_vtxResult;
layout(location = 0) out mediump vec4 dEQP_FragColor;

layout(set = 0, binding = 0, std140) uniform Block
{
	highp ivec3 var[3][4];
};

mediump float compare_ivec3    (highp ivec3 a, highp ivec3 b)  { return a == b ? 1.0 : 0.0; }

void main (void)
{
    mediump float result = 1.0;
	result *= compare_ivec3((var[0][0]), ivec3(0, 0, 0));
	result *= compare_ivec3((var[0][1]), ivec3(0, 0, 0));
	result *= compare_ivec3((var[0][2]), ivec3(0, 0, 0));
	result *= compare_ivec3((var[0][3]), ivec3(0, 0, 0));
	result *= compare_ivec3((var[1][0]), ivec3(0, 0, 0));
	result *= compare_ivec3((var[1][1]), ivec3(0, 0, 0));
	result *= compare_ivec3((var[1][2]), ivec3(0, 0, 0));
	result *= compare_ivec3((var[1][3]), ivec3(0, 0, 0));
	result *= compare_ivec3((var[2][0]), ivec3(0, 0, 0));
	result *= compare_ivec3((var[2][1]), ivec3(0, 0, 0));
	result *= compare_ivec3((var[2][2]), ivec3(0, 0, 0));
	result *= compare_ivec3((var[2][3]), ivec3(0, 0, 0));
    dEQP_FragColor = vec4(1.0, v_vtxResult, result, 1.0);
}
