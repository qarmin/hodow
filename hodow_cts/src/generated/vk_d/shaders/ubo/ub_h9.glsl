	result *= compare_uvec3((blockC[0].b), uvec3(0u, 0u, 0u));
	result *= compare_uvec3((blockC[1].b), uvec3(0u, 0u, 0u));
	result *= compare_bvec2((c), bvec2(false, false));
	result *= compare_int8_t(int(d), 0);
	result *= compare_vec3((e[0]), vec3(0.0, 0.0, 0.0));
	result *= compare_vec3((e[1]), vec3(0.0, 0.0, 0.0));
