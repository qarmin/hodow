void main (void)
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    mediump float result = 1.0;
	result *= compare_vec3((p), vec3(0.0, 0.0, 0.0));
	result *= compare_u16vec2(uvec2(q), uvec2(0u, 0u));
	result *= compare_float((blockH.r), 0.0);
	result *= compare_u16vec2(uvec2(blockH.s), uvec2(0u, 0u));
