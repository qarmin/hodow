%i = OpVariable %fp_i32 Function
%should_run    = OpFunctionCall %bool %isUniqueIdZero
                 OpSelectionMerge %end_if None
                 OpBranchConditional %should_run %run_test %end_if
%run_test      = OpLabel
                OpStore %i %c_i32_0
                OpBranch %loop
%loop = OpLabel
%15 = OpLoad %i32 %i
%lt = OpSLessThan %bool %15 %c_i32_limit
                OpLoopMerge %merge %inc None
                OpBranchConditional %lt %write %merge
%write = OpLabel
%30 = OpLoad %i32 %i
%two_i = OpIAdd %i32 %30 %30
%two_i_plus_1 = OpIAdd %i32 %two_i %c_i32_1
