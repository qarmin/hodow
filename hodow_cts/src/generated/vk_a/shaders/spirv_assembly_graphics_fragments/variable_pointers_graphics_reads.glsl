%loc_a_i = OpAccessChain %sb_f32 %indata_a %c_i32_0 %30
%loc_b_i = OpAccessChain %sb_f32 %indata_b %c_i32_0 %30
%loc_a_2i = OpAccessChain %sb_f32 %indata_a %c_i32_0 %two_i
%loc_a_2i_plus_1 = OpAccessChain %sb_f32 %indata_a %c_i32_0 %two_i_plus_1
%loc_outdata_i = OpAccessChain %sb_f32 %outdata  %c_i32_0 %30
%val_s_i = OpLoad %f32 %loc_s_i
%is_neg = OpFOrdLessThan %bool %val_s_i %c_f32_0
%mux_output_var_ptr = OpSelect %sb_f32 %is_neg %loc_a_2i  %loc_a_2i_plus_1 
%mux_output = OpLoad %f32 %mux_output_var_ptr
                OpStore %loc_outdata_i %mux_output
                OpBranch %inc
  %inc = OpLabel
   %37 = OpLoad %i32 %i
   %39 = OpIAdd %i32 %37 %c_i32_1
         OpStore %i %39
         OpBranch %loop
%merge = OpLabel
                 OpBranch %end_if
%end_if = OpLabel
OpReturnValue %param
OpFunctionEnd

